cure-requests"

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Cross-Origin-Opener-Policy "same-origin"

  # HSTS: ERST aktivieren, wenn HTTPS dauerhaft und korrekt eingerichtet ist!
  # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

# ----- Schutz sensibler Dateien ----------------------------------------------
<IfModule mod_authz_core.c>
  <FilesMatch "(^\.|\.(env|ini|log|sh|bak|dist|lock|json)$|composer\.(json|lock))">
    Require all denied
  </FilesMatch>
  # site.webmanifest ausdrücklich erlauben (endet auf .webmanifest, nicht .json)
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "(^\.|\.(env|ini|log|sh|bak|dist|lock|json)$)">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# Git-Metadaten sperren: Hostinger legt beim Git-Deployment ein .git-Verzeichnis
# in public_html an. Es darf nie ausgeliefert werden.
<IfModule mod_alias.c>
  RedirectMatch 404 /\.git(/|$)
</IfModule>

Options -Indexes

# ----- Kompression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# ----- Caching ---------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Gehashte Build-Assets: lange cachen
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/avif "access plus 30 days"
  # HTML: kurz cachen (Inhalte können sich ändern)
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
  # Immutable-Cache für die gehashten Astro-Assets
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.js$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ----- MIME ------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType font/woff2 .woff2
  AddType image/avif .avif
</IfModule>
