# =============================================================================
# KERNSEITE – Apache-Konfiguration (Sicherheit, Caching, Kompression)
# Ziel: normales deutsches Webhosting (Apache). Passe Werte bei Bedarf an.
# =============================================================================

# ----- HTTPS erzwingen -------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Endgültige Canonical-Domain: ein Schritt für HTTPS und www.
  RewriteCond %{HTTP_HOST} !^www\.kernseite\.com$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.kernseite.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ----- Fehlerseiten ----------------------------------------------------------
ErrorDocument 404 /404.html

# ----- Sicherheits-Header ----------------------------------------------------
