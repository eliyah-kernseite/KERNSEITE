---
/**
 * CtaBanner – vollbreite Abschluss-Sektion in KERNSEITE-Cyan.
 * Kein Kasten, kein Rahmen: die Fläche selbst ist der Handlungsaufruf.
 */
import { activeCompany } from '../lib/config-validation';

interface Props {
  title?: string;
  /**
   * Zweizeilige Überschrift mit markiertem Wort, wenn kein `title` gesetzt ist:
   * erste Zeile, Text vor der Markierung, markiertes Wort, Text danach.
   */
  markedTitle?: readonly [string, string, string, string];
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** Zweite Zeile: standardmäßig die E-Mail-Adresse. */
  secondaryLabel?: string;
  secondaryHref?: string;
}

const c = activeCompany;
const {
  title,
  markedTitle = ['Dein Unternehmen ist bereit.', 'Ist deine ', 'Website', ' es auch?'],
  text = 'Erzähl uns von deinem Unternehmen und deiner Idee. Im ersten Gespräch klären wir den passenden Umfang.',
  ctaLabel = 'Website anfragen',
  ctaHref = '/kontakt/',
  secondaryLabel = c.email,
  secondaryHref = `mailto:${c.email}`,
} = Astro.props;
---

<section class="cta section--cyan">
  <svg class="cta__badge" viewBox="0 0 200 200" aria-hidden="true" focusable="false">
    <defs>
      <path id="cta-ring" d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path>
    </defs>
    <text
      ><textPath href="#cta-ring" textLength="486" lengthAdjust="spacing"
        >Website anfragen · Website anfragen ·</textPath
      ></text
    >
    <circle cx="100" cy="100" r="16"></circle>
  </svg>
  <div class="content cta__inner">
    <h2 class="cta__title" data-split>
      {
        title ? (
          title
        ) : (
          <>
            {markedTitle[0]}
            <br />
            {markedTitle[1]}
            <em class="cta__mark">{markedTitle[2]}</em>
            {markedTitle[3]}
          </>
        )
      }
    </h2>
    <p class="cta__text">{text}</p>
    <div class="cta__actions">
      <a class="btn btn--primary btn--lg" href={ctaHref} data-magnetic
        >{ctaLabel} <span aria-hidden="true">↗</span></a
      >
      {
        secondaryLabel && secondaryHref && (
          <a class="cta__mailto" href={secondaryHref}>
            {secondaryLabel}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: clip;
    padding-block: calc(var(--section-y) * 1.2);
  }
  .cta__badge {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    display: none;
    inline-size: clamp(10rem, 16vw, 15rem);
    translate: 0 -50%;
    animation: cta-spin 22s linear infinite;
  }
  .cta__badge text {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    fill: var(--ks-black);
  }
  .cta__badge circle {
    fill: var(--ks-black);
  }
  @keyframes cta-spin {
    to {
      rotate: 360deg;
    }
  }
  @media (min-width: 72rem) {
    .cta__badge {
      display: block;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta__badge {
      animation: none;
    }
  }
  :global(:root[data-a11y-motion='reduced']) .cta__badge {
    animation: none;
  }
  .cta__inner {
    display: grid;
    gap: var(--space-xl);
    min-inline-size: 0;
  }
  .cta__inner > * {
    min-inline-size: 0;
  }
  .cta__title {
    font-size: clamp(2.8rem, 7.4vw, 8rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.055em;
    max-width: min(14ch, 100%);
  }
  /* Hervorhebung auf der Cyan-Fläche: rein typografisch, keine Fläche */
  .cta__mark {
    font-style: normal;
    background: none;
    color: var(--ks-black);
    /* Keine Unterstreichung: Markierte Wörter tragen keine Linie. Auf der
       Neon-Fläche trägt die Fläche selbst schon den Akzent. */
    text-decoration: none;
    white-space: nowrap;
  }
  /* Bei starkem Zoom passt das markierte Wort nicht mehr in die Zeile. */
  @media (max-width: 30rem) {
    .cta__mark {
      white-space: normal;
    }
  }
  .cta__text {
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: min(46ch, 100%);
    color: var(--ks-black);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg) var(--space-xl);
    margin-block-start: var(--space-md);
  }
  .cta__mailto {
    /* Die E-Mail-Adresse ist ein langes zusammenhängendes Wort. */
    overflow-wrap: anywhere;
    font-size: var(--fs-small);
    color: var(--ks-black);
    text-underline-offset: 0.3em;
  }
  @media (max-width: 30rem) {
    .cta__actions .btn {
      inline-size: 100%;
    }
  }
</style>
