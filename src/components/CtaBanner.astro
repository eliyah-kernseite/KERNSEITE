---
/**
 * CtaBanner – Abschluss jeder Seite. Unter dem Laufband geht eine
 * cyanfarbene Fläche auf, während man hineinscrollt (CSS-Scroll-Animation,
 * sonst `[data-grow]`), darauf die große Frage in Schwarz. Ohne Bewegung
 * steht die Fläche sofort voll da.
 */
import { activeCompany } from '../lib/config-validation';
import Marquee from './home/Marquee.astro';
import Seal from './Seal.astro';

interface Props {
  title?: string;
  /**
   * Zweizeilige Überschrift mit markiertem Wort, wenn kein `title` gesetzt ist:
   * erste Zeile, Text vor der Markierung, markiertes Wort, Text danach.
   */
  markedTitle?: readonly [string, string, string, string];
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** Zweite Zeile: standardmäßig die E-Mail-Adresse. */
  secondaryLabel?: string;
  secondaryHref?: string;
}

const c = activeCompany;
const {
  title,
  markedTitle = ['Dein Unternehmen ist bereit.', 'Ist deine ', 'Website', ' es auch?'],
  text = 'Erzähl uns von deinem Unternehmen und deiner Idee. Im ersten Gespräch klären wir den passenden Umfang.',
  ctaLabel = 'Website anfragen',
  ctaHref = '/kontakt/',
  secondaryLabel = c.email,
  secondaryHref = `mailto:${c.email}`,
} = Astro.props;
---

<section class="cta">
  <Marquee items={[ctaLabel]} />
  <div class="cta__panel section--cyan" data-grow>
    <div class="content cta__inner">
      <h2 class="cta__title" data-split>
        {
          title ? (
            title
          ) : (
            <>
              {markedTitle[0]}
              <br />
              {markedTitle[1]}
              <em class="cta__mark">{markedTitle[2]}</em>
              {markedTitle[3]}
            </>
          )
        }
      </h2>
      <p class="cta__text">{text}</p>
      <div class="cta__actions">
        <a class="btn btn--primary btn--lg" href={ctaHref} data-magnetic
          >{ctaLabel} <span aria-hidden="true">↗</span></a
        >
        {
          secondaryLabel && secondaryHref && (
            <span class="cta__mail">
              <a class="cta__mailto" href={secondaryHref}>
                {secondaryLabel}
              </a>
              {secondaryHref.startsWith('mailto:') && (
                <button type="button" class="cta__copy" data-copy={secondaryLabel}>
                  Kopieren
                </button>
              )}
            </span>
          )
        }
      </div>
      <Seal class="cta__seal" tone="dark" />
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: clip;
    background: var(--ks-black);
    border-block-start: 1px solid var(--line);
  }
  .cta :global(.marquee) {
    border-block-end: 1px solid var(--line);
  }
  .cta__panel {
    position: relative;
    isolation: isolate;
    padding-block: clamp(4.5rem, 11vw, 10rem);
    background: transparent;
    color: var(--ks-black);
  }
  /* Die Cyan-Fläche liegt als eigene Ebene hinter dem Text und wächst per
     scale auf volle Breite. Die Schrift bleibt dabei ruhig stehen. */
  .cta__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ks-cyan);
  }
  :global(html.has-scroll-fx) .cta__panel::before {
    transform: scale(calc(0.88 + 0.12 * var(--g, 1)));
    will-change: transform;
  }
  :global(html.has-sda) .cta__panel {
    view-timeline: --cta block;
  }
  :global(html.has-sda) .cta__panel::before {
    animation: cta-grow linear both;
    animation-timeline: --cta;
    animation-range: entry 0% entry 100%;
  }
  @keyframes cta-grow {
    from {
      transform: scale(0.88);
    }
    to {
      transform: none;
    }
  }
  .cta__inner {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    min-inline-size: 0;
  }
  .cta__inner :global(.cta__seal) {
    --seal-size: clamp(8rem, 11vw, 11rem);
    justify-self: start;
  }
  @media (min-width: 64rem) {
    .cta__inner :global(.cta__seal) {
      position: absolute;
      inset-block-start: 0;
      inset-inline-end: var(--gutter);
    }
  }
  .cta__inner > * {
    min-inline-size: 0;
  }
  .cta__title {
    font-size: clamp(3rem, 9vw, 10rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.04em;
    max-width: min(14ch, 100%);
  }
  .cta__mark {
    font-style: normal;
    background: none;
    color: var(--ks-black);
    text-decoration: underline;
    text-decoration-thickness: 0.08em;
    text-underline-offset: 0.12em;
    white-space: nowrap;
  }
  /* Bei starkem Zoom passt das markierte Wort nicht mehr in die Zeile. */
  @media (max-width: 30rem) {
    .cta__mark {
      white-space: normal;
    }
  }
  .cta__text {
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: min(46ch, 100%);
    color: var(--text-muted);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg) var(--space-xl);
    margin-block-start: var(--space-md);
  }
  .cta__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cta__copy {
    min-height: 44px;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--ks-black);
    background: transparent;
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition:
      border-color 300ms var(--ease-out),
      background-color 300ms var(--ease-out);
  }
  .cta__copy:hover,
  .cta__copy:focus-visible {
    background: var(--ks-black);
    color: var(--ks-cyan);
  }
  .cta__mailto {
    /* Die E-Mail-Adresse ist ein langes zusammenhängendes Wort. */
    overflow-wrap: anywhere;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    text-underline-offset: 0.3em;
  }
  @media (max-width: 30rem) {
    .cta__actions .btn {
      inline-size: 100%;
    }
  }
</style>
