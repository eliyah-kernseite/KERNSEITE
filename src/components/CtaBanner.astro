---
/**
 * CtaBanner – vollbreite Abschluss-Sektion. Dunkle Fläche mit weichem
 * türkisem Schein von unten, Türkis nur als Akzent statt als ganze Fläche.
 */
import { activeCompany } from '../lib/config-validation';
import Marquee from './home/Marquee.astro';

interface Props {
  title?: string;
  /**
   * Zweizeilige Überschrift mit markiertem Wort, wenn kein `title` gesetzt ist:
   * erste Zeile, Text vor der Markierung, markiertes Wort, Text danach.
   */
  markedTitle?: readonly [string, string, string, string];
  text?: string;
  ctaLabel?: string;
  ctaHref?: string;
  /** Zweite Zeile: standardmäßig die E-Mail-Adresse. */
  secondaryLabel?: string;
  secondaryHref?: string;
}

const c = activeCompany;
const {
  title,
  markedTitle = ['Dein Unternehmen ist bereit.', 'Ist deine ', 'Website', ' es auch?'],
  text = 'Erzähl uns von deinem Unternehmen und deiner Idee. Im ersten Gespräch klären wir den passenden Umfang.',
  ctaLabel = 'Website anfragen',
  ctaHref = '/kontakt/',
  secondaryLabel = c.email,
  secondaryHref = `mailto:${c.email}`,
} = Astro.props;
---

<section class="cta">
  <Marquee items={[ctaLabel]} />
  <div class="content cta__inner">
    <h2 class="cta__title" data-split>
      {
        title ? (
          title
        ) : (
          <>
            {markedTitle[0]}
            <br />
            {markedTitle[1]}
            <em class="cta__mark">{markedTitle[2]}</em>
            {markedTitle[3]}
          </>
        )
      }
    </h2>
    <p class="cta__text">{text}</p>
    <div class="cta__actions">
      <a class="btn btn--primary btn--lg" href={ctaHref} data-magnetic
        >{ctaLabel} <span aria-hidden="true">↗</span></a
      >
      {
        secondaryLabel && secondaryHref && (
          <span class="cta__mail">
            <a class="cta__mailto" href={secondaryHref}>
              {secondaryLabel}
            </a>
            {secondaryHref.startsWith('mailto:') && (
              <button type="button" class="cta__copy" data-copy={secondaryLabel}>
                Kopieren
              </button>
            )}
          </span>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: clip;
    padding-block: 0 calc(var(--section-y) * 1.1);
    background: var(--ks-black);
    border-block-start: 1px solid var(--line);
  }
  /* Weicher Schein statt voller Türkisfläche. */
  .cta::before {
    content: '';
    position: absolute;
    inset: auto -20% -55% auto;
    z-index: -1;
    inline-size: min(90vw, 70rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--ks-cyan) 13%, transparent),
      transparent
    );
    pointer-events: none;
  }
  .cta :global(.marquee) {
    margin-block-end: clamp(2rem, 5vw, 4rem);
    border-block-end: 1px solid var(--line);
  }
  .cta__inner {
    display: grid;
    gap: var(--space-xl);
    min-inline-size: 0;
  }
  .cta__inner > * {
    min-inline-size: 0;
  }
  .cta__title {
    font-size: clamp(3rem, 9vw, 10rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.055em;
    max-width: min(14ch, 100%);
  }
  .cta__mark {
    font-style: normal;
    background: none;
    color: var(--ks-cyan);
    text-decoration: none;
    white-space: nowrap;
  }
  /* Bei starkem Zoom passt das markierte Wort nicht mehr in die Zeile. */
  @media (max-width: 30rem) {
    .cta__mark {
      white-space: normal;
    }
  }
  .cta__text {
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: min(46ch, 100%);
    color: var(--text-muted);
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg) var(--space-xl);
    margin-block-start: var(--space-md);
  }
  .cta__mail {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
  }
  .cta__copy {
    min-height: 44px;
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text);
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
    transition:
      border-color 300ms var(--ease-out),
      background-color 300ms var(--ease-out);
  }
  .cta__copy:hover,
  .cta__copy:focus-visible {
    border-color: var(--ks-bone);
    background: color-mix(in srgb, var(--ks-bone) 8%, transparent);
  }
  .cta__mailto {
    /* Die E-Mail-Adresse ist ein langes zusammenhängendes Wort. */
    overflow-wrap: anywhere;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    text-underline-offset: 0.3em;
  }
  @media (max-width: 30rem) {
    .cta__actions .btn {
      inline-size: 100%;
    }
  }
</style>
