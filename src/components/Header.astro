---
import Logo from './Logo.astro';
import { mainNav, primaryCta } from '../config/navigation';
import { activeCompany as c } from '../lib/config-validation';

const currentPath = Astro.url.pathname;
function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  if (href === '/leistungen/' && currentPath.startsWith('/leistungen/websites/')) return false;
  return currentPath.startsWith(href);
}
---

<header class="site-header" data-header>
  <span class="site-header__progress" data-scroll-progress aria-hidden="true"></span>
  <div class="site-header__inner container">
    <a class="site-header__brand" href="/" aria-label="KERNSEITE, zur Startseite">
      <Logo />
    </a>

    <nav class="primary-nav" aria-label="Hauptnavigation">
      <ul role="list">
        {
          mainNav.map((item) => (
            <li>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                <span class="primary-nav__label" data-label={item.label}>
                  {item.label}
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="btn btn--primary site-header__cta" href={primaryCta.href} data-magnetic
        >{primaryCta.label} <span aria-hidden="true">↗</span></a
      >
      <button
        type="button"
        class="burger"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="burger__box" aria-hidden="true">
          <span class="burger__line"></span>
          <span class="burger__line"></span>
        </span>
        <span class="visually-hidden">Menü öffnen</span>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="mobile-menu" data-mobile-menu hidden>
    <nav class="mobile-menu__nav" aria-label="Mobile Navigation">
      <ul role="list">
        {
          mainNav.map((item, i) => (
            <li class={`mobile-menu__item mobile-menu__item--${i + 1}`}>
              <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="btn btn--primary mobile-menu__cta" href={primaryCta.href}>{primaryCta.label}</a>
      <p class="mobile-menu__contact">
        <a href={`mailto:${c.email}`}>{c.email}</a>
        <a href={`tel:+49${c.phone.replace(/\D/g, '').replace(/^0/, '')}`}>{c.phone}</a>
      </p>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    color: var(--text);
    transition:
      transform 500ms var(--ease-out),
      background-color var(--dur-base) var(--ease-out),
      border-color var(--dur-base) var(--ease-out);
    border-block-end: 1px solid transparent;
  }
  .site-header[data-scrolled] {
    /* Fast deckend statt Weichzeichner: Ein Blur über bewegtem Inhalt kostet
       auf Tablets bei jedem Scrollbild viel Rechenzeit. */
    background: color-mix(in srgb, var(--ks-paper) 94%, transparent);
    border-block-end-color: color-mix(in srgb, var(--ks-bone) 8%, transparent);
  }
  /* Beim Herunterscrollen weicht die Kopfzeile, beim Hochscrollen kommt sie zurück. */
  .site-header[data-hidden] {
    transform: translate3d(0, -100%, 0);
  }
  :global(html[data-menu-open]) .site-header {
    transform: none;
    background: var(--ks-paper);
  }

  /* Lesefortschritt: dünne türkise Linie an der Unterkante. */
  .site-header__progress {
    position: absolute;
    inset: auto 0 -1px;
    block-size: 2px;
    background: var(--ks-cyan);
    transform: scaleX(var(--scroll, 0));
    transform-origin: left;
    pointer-events: none;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: var(--header-h);
  }

  .site-header__brand {
    font-size: 1.45rem;
    text-decoration: none;
    color: var(--text);
  }

  .primary-nav {
    display: none;
  }
  .primary-nav ul {
    display: flex;
    gap: clamp(0.5rem, 0.2rem + 1.4vw, 2.25rem);
    margin: 0;
    padding: 0;
  }
  .primary-nav a {
    display: inline-block;
    padding: 0.6rem 0.2rem;
    font-size: 0.975rem;
    font-weight: var(--fw-medium);
    text-decoration: none;
    color: var(--text);
    position: relative;
  }
  /* Wort rollt beim Überfahren nach oben aus, die Kopie rollt nach. */
  .primary-nav__label {
    display: inline-block;
    position: relative;
    overflow: hidden;
    vertical-align: top;
  }
  .primary-nav__label::after {
    content: attr(data-label);
    position: absolute;
    inset: 100% 0 auto;
    color: var(--ks-cyan);
  }
  .primary-nav__label,
  .primary-nav__label::after {
    transition: transform 450ms var(--ease-out);
  }
  .primary-nav a:hover .primary-nav__label,
  .primary-nav a:focus-visible .primary-nav__label {
    transform: translateY(-100%);
  }
  .primary-nav__label {
    transform: translateY(0);
  }
  /* Aktuelle Seite: türkiser Strich unter dem Wort. */
  .primary-nav a::before {
    content: '';
    position: absolute;
    left: 0.2rem;
    right: 0.2rem;
    bottom: 0.2rem;
    block-size: 2px;
    background: var(--ks-cyan);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 450ms var(--ease-out);
  }
  .primary-nav a[aria-current='page']::before,
  .primary-nav a:hover::before {
    transform: scaleX(1);
    transform-origin: left;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }
  .site-header__cta {
    display: none;
    min-height: 46px;
    padding: 0.6rem 1.35rem;
  }

  .burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 48px;
    block-size: 48px;
    margin-inline-end: -0.5rem;
    border: 0;
    background: transparent;
  }
  .burger__box {
    display: grid;
    gap: 7px;
    inline-size: 26px;
  }
  .burger__line {
    display: block;
    block-size: 2px;
    background: var(--text);
    transition: transform 400ms var(--ease-out);
  }
  .burger__line:nth-child(2) {
    inline-size: 70%;
    justify-self: end;
    transition:
      transform 400ms var(--ease-out),
      inline-size 400ms var(--ease-out);
  }
  .burger[aria-expanded='true'] .burger__line:nth-child(1) {
    transform: translateY(4.5px) rotate(45deg);
  }
  .burger[aria-expanded='true'] .burger__line:nth-child(2) {
    inline-size: 100%;
    transform: translateY(-4.5px) rotate(-45deg);
  }

  .mobile-menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    overflow-y: auto;
    background: var(--ks-paper);
  }
  .mobile-menu[hidden] {
    display: none;
  }
  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    padding: var(--space-xl) var(--gutter) var(--space-2xl);
  }
  .mobile-menu__nav ul {
    display: grid;
    margin: 0 0 var(--space-2xl);
    padding: 0;
  }
  .mobile-menu__nav li a {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 10vw, 3.4rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.045em;
    text-decoration: none;
    color: var(--text);
    border-block-end: 1px solid var(--line);
  }
  .mobile-menu__nav li a[aria-current='page'] {
    color: var(--ks-cyan);
  }
  .mobile-menu__item {
    animation: menu-in 700ms var(--ease-out) both;
  }
  .mobile-menu__item--2 {
    animation-delay: 60ms;
  }
  .mobile-menu__item--3 {
    animation-delay: 120ms;
  }
  .mobile-menu__item--4 {
    animation-delay: 180ms;
  }
  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(1.5rem);
    }
  }
  .mobile-menu__cta {
    inline-size: 100%;
  }
  .mobile-menu__contact {
    display: grid;
    gap: 0.4rem;
    margin-block-start: auto;
    padding-block-start: var(--space-2xl);
  }
  .mobile-menu__contact a {
    color: var(--text-muted);
    text-decoration: none;
  }

  @media (max-width: 26rem) {
    .site-header__brand {
      font-size: 1.2rem;
    }
  }

  @media (min-width: 64rem) {
    .primary-nav {
      display: block;
    }
    .site-header__cta {
      display: inline-flex;
    }
    .burger,
    .mobile-menu {
      display: none;
    }
  }
</style>

<script>
  // Header: Scroll-Kompakt-Zustand + zugängliches Mobil-Menü (Fokusfalle, Escape, Scroll-Lock).
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');

  // Kompakt-Zustand beim Scrollen
  if (header) {
    let ticking = false;
    let lastY = 0;
    const update = () => {
      const y = window.scrollY;
      if (y > 8) header.setAttribute('data-scrolled', '');
      else header.removeAttribute('data-scrolled');
      // Ausblenden nur nach echtem Herunterscrollen und nie bei offenem Menü oder Fokus darin.
      const down = y > lastY + 4 && y > 240;
      const up = y < lastY - 4;
      if (down && !header.contains(document.activeElement)) header.setAttribute('data-hidden', '');
      else if (up || y <= 240) header.removeAttribute('data-hidden');
      lastY = y;
      ticking = false;
    };
    // Erste Prüfung im nächsten Frame: scrollY direkt beim Laden erzwingt sonst
    // eine zusätzliche Layout-Berechnung, während die Seite noch aufgebaut wird.
    requestAnimationFrame(update);
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true },
    );
  }

  if (toggle && menu) {
    const focusableSelector =
      'a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])';
    let lastFocused: HTMLElement | null = null;

    const getFocusable = (): HTMLElement[] =>
      Array.from(menu.querySelectorAll<HTMLElement>(focusableSelector));

    const openMenu = () => {
      lastFocused = document.activeElement as HTMLElement;
      menu.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      toggle.querySelector('.visually-hidden')!.textContent = 'Menü schließen';
      document.documentElement.setAttribute('data-menu-open', '');
      getFocusable()[0]?.focus();
      document.addEventListener('keydown', onKeydown);
    };

    const closeMenu = () => {
      menu.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      toggle.querySelector('.visually-hidden')!.textContent = 'Menü öffnen';
      document.documentElement.removeAttribute('data-menu-open');
      document.removeEventListener('keydown', onKeydown);
      lastFocused?.focus();
    };

    const onKeydown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu();
        return;
      }
      if (event.key === 'Tab') {
        const items = getFocusable();
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    };

    toggle.addEventListener('click', () => {
      if (toggle.getAttribute('aria-expanded') === 'true') closeMenu();
      else openMenu();
    });

    // Beim Wechsel in Desktop-Breite Menü sicher schließen
    const mq = window.matchMedia('(min-width: 64rem)');
    mq.addEventListener('change', (e) => {
      if (e.matches && toggle.getAttribute('aria-expanded') === 'true') closeMenu();
    });

    // Nach Klick auf einen Menülink schließen (SPA-freundlich)
    menu.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('a')) closeMenu();
    });
  }
</script>
