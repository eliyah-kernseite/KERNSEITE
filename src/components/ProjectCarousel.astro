---
/**
 * Referenz-Karussell (Startseite): Projekte drehen sich wie auf einem Rad.
 * Bedienung per Wischen, Pfeiltasten, Pfeil-Buttons und Punkten.
 *
 * Ohne JavaScript steht das Startprojekt in der Mitte, die Nachbarn daneben
 * (Klassen is-active / is-prev / is-next). Das Skript übernimmt danach die
 * stufenlose Positionierung über CSSOM (CSP-tauglich, keine Inline-Styles).
 */
import { featuredProjects } from '../config/cases';

/** Kaya Döner bleibt das Startmotiv (größtes Bild beim ersten Laden). */
const startSlug = 'kaya-doener-himmelstadt';
const projects = featuredProjects;
const start = Math.max(
  0,
  projects.findIndex((p) => p.slug === startSlug),
);
const n = projects.length;
const posClass = (i: number) => {
  const d = (((i - start) % n) + n) % n;
  if (d === 0) return 'is-active';
  if (d === 1) return 'is-next';
  if (d === n - 1) return 'is-prev';
  return 'is-hidden';
};
---

<div
  class="pc"
  data-carousel
  data-start={start}
  role="region"
  aria-roledescription="Karussell"
  aria-label="Ausgewählte Websiteprojekte"
>
  <div class="pc__stage" data-stage>
    {
      projects.map((p, i) => (
        <a
          class:list={['pc__slide', posClass(i)]}
          href={p.href}
          data-slide
          data-title={p.title}
          data-meta={p.industryLabel}
          data-text={p.teaser}
          aria-label={`Projekt ${i + 1} von ${n} ansehen: ${p.title}`}
          aria-hidden={i === start ? undefined : 'true'}
          tabindex={i === start ? undefined : -1}
          draggable="false"
        >
          <span class="visually-hidden">Projekt ansehen: {p.title}</span>
          <img
            src={p.screenshotDesktop.src}
            srcset={p.screenshotDesktop.srcset}
            sizes="(min-width: 900px) 56vw, 80vw"
            width={p.screenshotDesktop.width}
            height={p.screenshotDesktop.height}
            alt={p.screenshotDesktop.alt}
            loading="lazy"
            decoding="async"
            draggable="false"
          />
        </a>
      ))
    }
    <button class="pc__nav pc__nav--prev" type="button" data-prev aria-label="Vorheriges Projekt">
      <span aria-hidden="true">‹</span>
    </button>
    <button class="pc__nav pc__nav--next" type="button" data-next aria-label="Nächstes Projekt">
      <span aria-hidden="true">›</span>
    </button>
  </div>

  <div class="pc__caption" aria-live="polite">
    <p class="pc__title" data-caption-title>{projects[start].title}</p>
    <p class="pc__meta" data-caption-meta>{projects[start].industryLabel}</p>
    <p class="pc__text" data-caption-text>{projects[start].teaser}</p>
  </div>

  <div class="pc__dots" role="group" aria-label="Projekt auswählen">
    {
      projects.map((p, i) => (
        <button
          class="pc__dot"
          type="button"
          data-dot={i}
          aria-label={`Projekt ${i + 1}: ${p.title}`}
          aria-current={i === start ? 'true' : undefined}
        />
      ))
    }
  </div>
</div>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const stage = root.querySelector<HTMLElement>('[data-stage]')!;
    const slides = [...root.querySelectorAll<HTMLAnchorElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const titleEl = root.querySelector<HTMLElement>('[data-caption-title]')!;
    const metaEl = root.querySelector<HTMLElement>('[data-caption-meta]')!;
    const textEl = root.querySelector<HTMLElement>('[data-caption-text]')!;
    const n = slides.length;
    let current = Number(root.dataset.start) || 0;
    let drag = 0; // Ziehweg in Folienbreiten (positiv = nach links gezogen)

    /** Kürzester Abstand einer Folie zur Mitte, im Kreis gerechnet. */
    const offsetOf = (i: number) => {
      let d = i - current - drag;
      d = ((((d + n / 2) % n) + n) % n) - n / 2;
      return d;
    };

    const layout = () => {
      const narrow = stage.clientWidth < 700;
      const step = narrow ? 62 : 58; // horizontaler Abstand in % der Folienbreite
      slides.forEach((slide, i) => {
        const d = offsetOf(i);
        const a = Math.abs(d);
        const scale = 1 - Math.min(a, 2) * 0.16;
        const rotate = Math.max(-1.5, Math.min(1.5, d)) * -32;
        slide.style.transform =
          `translate(-50%, -50%) translateX(${d * step}%) ` +
          `rotateY(${rotate}deg) scale(${scale})`;
        slide.style.zIndex = String(100 - Math.round(a * 10));
        slide.style.opacity = a > 1.6 ? '0' : String(1 - Math.min(a, 1) * 0.45);
        slide.classList.remove('is-active', 'is-prev', 'is-next', 'is-hidden');
      });
    };

    const select = (index: number) => {
      current = ((index % n) + n) % n;
      drag = 0;
      slides.forEach((slide, i) => {
        const active = i === current;
        if (active) {
          slide.removeAttribute('aria-hidden');
          slide.removeAttribute('tabindex');
        } else {
          slide.setAttribute('aria-hidden', 'true');
          slide.setAttribute('tabindex', '-1');
        }
      });
      dots.forEach((dot, i) =>
        i === current
          ? dot.setAttribute('aria-current', 'true')
          : dot.removeAttribute('aria-current'),
      );
      const s = slides[current];
      titleEl.textContent = s.dataset.title ?? '';
      metaEl.textContent = s.dataset.meta ?? '';
      textEl.textContent = s.dataset.text ?? '';
      root.classList.remove('is-dragging');
      layout();
    };

    root.querySelector('[data-prev]')!.addEventListener('click', () => select(current - 1));
    root.querySelector('[data-next]')!.addEventListener('click', () => select(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => select(i)));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        select(current - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        select(current + 1);
      }
    });

    // Wischen / Ziehen
    let startX = 0;
    let startY = 0;
    let pointerId: number | null = null;
    let moved = false;
    let horizontal: boolean | null = null;

    stage.addEventListener('pointerdown', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;
      pointerId = e.pointerId;
      startX = e.clientX;
      startY = e.clientY;
      moved = false;
      horizontal = null;
    });

    stage.addEventListener('pointermove', (e) => {
      if (pointerId !== e.pointerId) return;
      const dx = e.clientX - startX;
      const dy = e.clientY - startY;
      if (horizontal === null && (Math.abs(dx) > 6 || Math.abs(dy) > 6)) {
        horizontal = Math.abs(dx) > Math.abs(dy);
        if (horizontal) {
          stage.setPointerCapture(e.pointerId);
          root.classList.add('is-dragging');
        }
      }
      if (!horizontal) return;
      moved = true;
      const width = slides[0].offsetWidth || stage.clientWidth;
      drag = -dx / (width * 0.75);
      layout();
    });

    const end = (e: PointerEvent) => {
      if (pointerId !== e.pointerId) return;
      pointerId = null;
      if (moved) {
        const shift =
          Math.abs(drag) > 0.18 ? Math.sign(drag) * Math.max(1, Math.round(Math.abs(drag))) : 0;
        select(current + shift);
      }
    };
    stage.addEventListener('pointerup', end);
    stage.addEventListener('pointercancel', end);

    // Klick: Mitte öffnet das Projekt, Seitenfolien drehen nach vorn.
    slides.forEach((slide, i) => {
      slide.addEventListener('click', (e) => {
        if (moved) {
          e.preventDefault();
          moved = false;
          return;
        }
        if (i !== current) {
          e.preventDefault();
          select(i);
        }
      });
    });

    const applyMotion = () => root.classList.toggle('is-static', reduceMotion.matches);
    reduceMotion.addEventListener('change', applyMotion);
    applyMotion();

    window.addEventListener('resize', layout, { passive: true });
    root.classList.add('is-ready');
    select(current);
  }
</script>

<style>
  .pc {
    position: relative;
  }
  .pc__stage {
    position: relative;
    height: clamp(15rem, 34vw, 33rem);
    perspective: 1600px;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    overflow: hidden;
  }
  .pc__slide {
    position: absolute;
    top: 50%;
    left: 50%;
    width: min(56%, 60rem);
    aspect-ratio: 2.1 / 1;
    border-radius: 0.8rem;
    overflow: hidden;
    border: 5px solid #363838;
    box-shadow: 0 1.5rem 4rem #0009;
    background: var(--ks-black-soft);
    transform-style: preserve-3d;
    transition:
      transform 0.6s var(--ease-out),
      opacity 0.6s var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }
  .pc__slide img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    pointer-events: none;
  }
  /* Ausgangslage ohne JavaScript */
  .pc__slide.is-active {
    transform: translate(-50%, -50%);
    z-index: 3;
  }
  .pc__slide.is-prev {
    transform: translate(-50%, -50%) translateX(-58%) rotateY(32deg) scale(0.84);
    opacity: 0.55;
    z-index: 2;
  }
  .pc__slide.is-next {
    transform: translate(-50%, -50%) translateX(58%) rotateY(-32deg) scale(0.84);
    opacity: 0.55;
    z-index: 2;
  }
  .pc__slide.is-hidden {
    transform: translate(-50%, -50%) scale(0.6);
    opacity: 0;
  }
  .pc.is-dragging .pc__slide,
  .pc.is-static .pc__slide {
    transition: none;
  }
  .pc__slide:focus-visible {
    outline: 3px solid var(--ks-cyan);
    outline-offset: 4px;
  }

  .pc__nav {
    position: absolute;
    top: 50%;
    z-index: 200;
    display: none;
    place-items: center;
    width: 3.4rem;
    height: 3.4rem;
    margin-top: -1.7rem;
    border: 0;
    border-radius: 50%;
    background: #1d2023e6;
    color: var(--ks-cream);
    font-size: 2rem;
    line-height: 1;
    cursor: pointer;
    transition: background var(--dur-base) var(--ease-out);
  }
  .pc.is-ready .pc__nav {
    display: grid;
  }
  .pc__nav span {
    margin-top: -0.2rem;
  }
  .pc__nav:hover {
    background: #2c3034;
  }
  .pc__nav:focus-visible {
    outline: 3px solid var(--ks-cyan);
    outline-offset: 2px;
  }
  .pc__nav--prev {
    left: clamp(0.75rem, 3vw, 2.5rem);
  }
  .pc__nav--next {
    right: clamp(0.75rem, 3vw, 2.5rem);
  }

  .pc__caption {
    text-align: center;
    padding: clamp(1.25rem, 2.5vw, 2rem) 1.25rem 0;
    max-width: 42rem;
    margin: 0 auto;
  }
  .pc__title {
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    letter-spacing: -0.03em;
    line-height: 1.1;
    color: var(--ks-cream);
  }
  .pc__meta {
    margin-top: 0.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #9ea3a8;
  }
  .pc__text {
    margin-top: 0.75rem;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.5;
    color: #c5c8cb;
  }

  .pc__dots {
    display: none;
    justify-content: center;
    gap: 0.6rem;
    padding: 1.1rem 0 0.4rem;
  }
  .pc.is-ready .pc__dots {
    display: flex;
  }
  .pc__dot {
    width: 0.65rem;
    height: 0.65rem;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #5b6066;
    cursor: pointer;
    transition:
      background var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out);
  }
  .pc__dot[aria-current='true'] {
    background: var(--ks-cream);
    transform: scale(1.25);
  }
  .pc__dot:focus-visible {
    outline: 2px solid var(--ks-cyan);
    outline-offset: 3px;
  }

  @media (max-width: 700px) {
    .pc__stage {
      height: clamp(12rem, 52vw, 20rem);
    }
    .pc__slide {
      width: 78%;
      border-width: 3px;
      border-radius: 0.6rem;
    }
    .pc__nav {
      width: 2.6rem;
      height: 2.6rem;
      margin-top: -1.3rem;
      font-size: 1.6rem;
    }
  }
</style>
