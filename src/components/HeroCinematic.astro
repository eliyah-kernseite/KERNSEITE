---
import ProjectCarousel from './ProjectCarousel.astro';
import DeviceScene from './DeviceScene.astro';
---

<section class="home-hero">
  <div class="content">
    <div class="hero-heading">
      <div class="hero-copy">
        <h1>Dein Können.<br />Deine <span>Website.</span></h1>
        <div class="hero-intro">
          <p>Du machst gute Arbeit.<br />Wir sorgen dafür, dass man sie auch online erkennt.</p>
          <a class="btn btn--primary" href="/kontakt/"
            >Lass uns deine Website planen <span aria-hidden="true">↗</span></a
          >
          <a class="quiet-link" href="/leistungen/websites/#website-angebot"
            >Individuelle Websites · 1.500–5.500 € netto</a
          >
        </div>
      </div>
      <DeviceScene />
    </div>
  </div>
  <div class="hero-stage">
    <div class="stage-top">
      <span>So unterschiedlich wie unsere Kunden.</span><a href="/arbeiten/"
        >Projekte entdecken <span aria-hidden="true">↗</span></a
      >
    </div>
    <ProjectCarousel />
    <div class="stage-bottom">
      <span>Konzept. Texte. Design. Entwicklung.</span><span
        >Alles mit einem persönlichen Ansprechpartner.</span
      >
    </div>
  </div>
</section>
<style>
  .home-hero {
    padding-top: clamp(2.8rem, 6vw, 6rem);
  }
  .eyebrow {
    font-size: 0.9375rem;
    font-weight: 500;
    margin-bottom: 2.2rem;
  }
  .hero-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    align-items: center;
    gap: clamp(2rem, 4vw, 4.5rem);
    padding-bottom: 4.5rem;
  }
  h1 {
    font-size: clamp(3.4rem, 6vw, 6.4rem);
    line-height: 1.02;
    letter-spacing: -0.055em;
    max-width: 10ch;
  }
  h1 span {
    display: inline-block;
    background: var(--ks-cyan);
    padding: 0 0.13em 0.08em;
    margin-left: -0.13em;
    border-radius: 0.13em;
    transform: rotate(-2deg);
    color: var(--ks-black);
  }
  .hero-intro {
    margin-top: clamp(1.5rem, 2.5vw, 2.5rem);
    max-width: 29rem;
  }
  .hero-intro p {
    font-size: clamp(1.2rem, 1.6vw, 1.55rem);
    line-height: 1.5;
    margin-bottom: 1.8rem;
    color: var(--text);
  }
  .hero-intro .btn {
    font-size: 1rem;
    padding: 1.1rem 1.35rem;
  }
  .quiet-link {
    display: block;
    margin-top: 1rem;
    font-size: 1rem;
    text-decoration: none;
    color: var(--text-muted);
  }
  .quiet-link:hover {
    text-decoration: underline;
  }
  .hero-stage {
    margin: 0 clamp(1rem, 2vw, 2.5rem);
    background: var(--ks-black);
    color: var(--ks-cream);
    border-radius: 1.5rem;
    overflow: hidden;
  }
  .stage-top,
  .stage-bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.8rem 2rem;
    font-size: 1rem;
    position: relative;
    z-index: 4;
  }
  .stage-top a {
    color: var(--ks-cyan);
    text-decoration: none;
  }
  .stage-bottom {
    color: #c5c8cb;
    padding-top: 1.5rem;
    border-top: 1px solid #ffffff14;
    margin-top: 1.5rem;
  }
  @media (max-width: 850px) {
    .hero-heading {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-bottom: 3rem;
    }
    h1 {
      font-size: clamp(3.6rem, 10.5vw, 6.2rem);
    }
    .hero-intro {
      max-width: none;
    }
    .hero-intro p {
      font-size: 1.2rem;
    }
    .eyebrow {
      max-width: 28ch;
      margin-bottom: 1.7rem;
    }
    .stage-top,
    .stage-bottom {
      padding: 1.25rem;
      font-size: 0.8rem;
    }
    .stage-top > span {
      max-width: 18ch;
    }
    .stage-bottom > span:last-child {
      display: none;
    }
    .stage-bottom {
      padding-top: 1.1rem;
    }
    .hero-stage {
      border-radius: 1rem;
    }
    .quiet-link {
      font-size: 0.8rem;
    }
  }
</style>
