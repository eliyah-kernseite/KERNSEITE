---
import { featuredProjects } from '../config/cases';
---

<ul class="projects" role="list">
  {
    featuredProjects.map((project) => (
      <li>
        <a class="project" href={project.href}>
          <div class="project__image">
            <img
              src={project.screenshotDesktop.src}
              srcset={project.screenshotDesktop.srcset}
              sizes="(min-width: 80rem) 620px, (min-width: 48rem) 45vw, 100vw"
              width={project.screenshotDesktop.width}
              height={project.screenshotDesktop.height}
              alt={project.screenshotDesktop.alt}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="project__heading">
            <>
              <h3>{project.title}</h3>
              <span aria-hidden="true">↗</span>
            </>
          </div>
          <p class="project__category">
            {project.industryLabel}
            {project.stage === 'preview' ? ' · Website-Entwurf' : ' · Website'}
          </p>
        </a>
        <p class="project__description">{project.tagline}</p>
      </li>
    ))
  }
</ul>
<style>
  .projects {
    display: grid;
    gap: 3.5rem 2rem;
  }
  .projects > li {
    min-width: 0;
  }
  .project {
    color: var(--text);
    text-decoration: none;
  }
  .project__image {
    display: flex;
    flex-direction: column;
    justify-content: end;
    background: var(--surface-alt);
    overflow: hidden;
    border-radius: 14px;
    aspect-ratio: 1.6;
  }
  .project__image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 1.5rem;
    transition: transform 0.4s ease;
  }
  .project:hover h3 {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .project__heading {
    display: flex;
    gap: 1rem;
    align-items: baseline;
    justify-content: space-between;
    margin-block-start: 1.1rem;
  }
  .project__heading h3 {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
    line-height: 1.3;
  }
  .project__heading > span {
    font-size: 1.25rem;
  }
  .project__category {
    font-size: 0.9375rem;
    color: var(--text-muted);
    margin-block-start: 0.3rem;
  }
  .project__description {
    margin-block-start: 0.65rem;
    max-width: 54ch;
    font-size: 1rem;
    color: var(--text-muted);
  }
  @media (min-width: 48rem) {
    .projects {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 30rem) {
    .project__image {
      aspect-ratio: auto;
    }
  }
</style>

<style>
  .projects > li:nth-child(2) .project__image {
    background: #242828;
  }
  .projects > li:nth-child(3) .project__image {
    background: #d8ded5;
  }
  .project:hover img {
    transform: scale(1.035);
  }
  @media (min-width: 48rem) {
    .projects > li:nth-child(even) {
      padding-top: 4rem;
    }
  }
  @media (max-width: 30rem) {
    .project__image img {
      padding: 0.75rem;
    }
  }
</style>
