---
import { services } from '../config/services';
import { industries } from '../config/industries';
import { IS_PREVIEW } from '../lib/build-mode';
import { activeCompany } from '../lib/config-validation';
const serviceKeys = services.map((s) => s.key);
const branchSlugs = industries.map((i) => i.slug);
const branchLabels = Object.fromEntries(industries.map((i) => [i.slug, i.label]));
const ACTION = '/api/contact.php';
const scopes = [
  'Noch offen',
  'Einzelne Landingpage / Onepager',
  'Unternehmenswebsite',
  'Umfangreicher Relaunch',
];
const timings = [
  'So bald wie möglich',
  'In den nächsten 3 Monaten',
  'In 3–6 Monaten',
  'Noch offen',
];
---

<form
  class="cform"
  method="post"
  action={IS_PREVIEW ? `mailto:${activeCompany.email}` : ACTION}
  data-contact-form
  data-email={activeCompany.email}
  data-preview={IS_PREVIEW ? '' : undefined}
  data-service-keys={serviceKeys.join(',')}
  data-branch-slugs={branchSlugs.join(',')}
  data-branch-labels={JSON.stringify(branchLabels)}
>
  {
    IS_PREVIEW && (
      <p class="cform__email-note">
        Deine Angaben werden in dein E-Mail-Programm übernommen. Du prüfst die Nachricht und sendest
        sie dort ab.
      </p>
    )
  }
  <div class="cform__hp" aria-hidden="true">
    <label for="cf-website2">Bitte dieses Feld frei lassen</label><input
      id="cf-website2"
      name="website2"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>
  <input type="hidden" name="rendered_at" data-rendered-at value="" />
  <input type="hidden" name="branch" value="" data-branch-field />

  <fieldset class="cform__group">
    <legend class="cform__legend">So erreichen wir dich</legend>
    <div class="cform__grid">
      <div class="field">
        <label for="cf-name">Dein Name <span class="field__req">Pflichtfeld</span></label><input
          id="cf-name"
          name="name"
          type="text"
          autocomplete="name"
          maxlength="120"
          required
          data-label="Name"
        />
      </div>
      <div class="field">
        <label for="cf-email">Deine E-Mail <span class="field__req">Pflichtfeld</span></label><input
          id="cf-email"
          name="email"
          type="email"
          autocomplete="email"
          inputmode="email"
          maxlength="200"
          required
          data-label="E-Mail"
        />
      </div>
      <div class="field">
        <label for="cf-phone">Telefon <span class="field__opt">optional</span></label><input
          id="cf-phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          maxlength="60"
        />
      </div>
      <div class="field">
        <label for="cf-company">Unternehmen <span class="field__opt">optional</span></label><input
          id="cf-company"
          name="company"
          type="text"
          autocomplete="organization"
          maxlength="160"
        />
      </div>
    </div>
  </fieldset>

  <fieldset class="cform__group">
    <legend class="cform__legend">Dein Projekt</legend>
    <div class="cform__grid">
      <div class="field field--full">
        <label for="cf-message">Worum geht es? <span class="field__req">Pflichtfeld</span></label
        ><textarea
          id="cf-message"
          name="message"
          rows="5"
          minlength="10"
          maxlength="5000"
          required
          data-label="Nachricht"
          aria-describedby="cf-message-hint"></textarea><p id="cf-message-hint" class="field__hint">
          Was bietet dein Unternehmen an, und was soll die neue Website erreichen? Ein paar Sätze
          reichen.
        </p>
      </div>
      <div class="field">
        <label for="cf-service">Gewünschte Leistung <span class="field__opt">optional</span></label
        ><select id="cf-service" name="service"
          ><option value="">Bitte wählen …</option>{
            services.map((s) => (
              <option value={s.label} data-key={s.key}>
                {s.cardTitle}
              </option>
            ))
          }<option value="Noch unklar">Noch unklar</option></select
        >
      </div>
      <div class="field">
        <label for="cf-budget">Geplantes Budget <span class="field__opt">optional</span></label
        ><select id="cf-budget" name="budget"
          ><option value="">Noch offen</option><option>1.499–3.000 € netto</option><option
            >3.000–5.500 € netto</option
          ><option>Mehr als 5.500 € netto</option></select
        >
      </div>
      <div class="field">
        <label for="cf-scope">Projektumfang <span class="field__opt">optional</span></label><select
          id="cf-scope"
          name="scope"
          ><option value="">Bitte wählen …</option>{
            scopes.map((s) => <option value={s}>{s}</option>)
          }</select
        >
      </div>
      <div class="field">
        <label for="cf-timing">Gewünschter Start <span class="field__opt">optional</span></label
        ><select id="cf-timing" name="timing"
          ><option value="">Bitte wählen …</option>{
            timings.map((t) => <option value={t}>{t}</option>)
          }</select
        >
      </div>
      <div class="field field--full">
        <label for="cf-existing">Bestehende Website <span class="field__opt">optional</span></label
        ><input
          id="cf-existing"
          name="existing_site"
          type="text"
          inputmode="url"
          maxlength="300"
          placeholder="www.dein-unternehmen.de"
        />
      </div>
    </div>
  </fieldset>

  <p class="cform__privacy">
    Mit dem Absenden verarbeiten wir deine Angaben zur Bearbeitung deiner Anfrage. Weitere
    Informationen findest du in der <a href="/datenschutz/">Datenschutzerklärung</a>.
  </p>
  <div class="cform__actions">
    <button type="submit" class="btn btn--primary" data-submit
      >{IS_PREVIEW ? 'Anfrage im E-Mail-Programm öffnen' : 'Unverbindliche Anfrage senden'}</button
    >
  </div>
  <div class="cform__feedback" data-feedback>
    <p class="cform__status" role="status" aria-live="polite" data-status></p>
    <ul class="cform__missing" data-missing hidden></ul>
    <div class="cform__fallback" data-fallback hidden>
      <a class="btn btn--ghost" href={`mailto:${activeCompany.email}`} data-fallback-mail
        >Angaben per E-Mail senden <span aria-hidden="true">↗</span></a
      >
      <span class="cform__fallback-note">Dein Text wird ins E-Mail-Programm übernommen.</span>
    </div>
  </div>
</form>

<style>
  .cform__preview {
    padding: 1rem;
    background: var(--ks-surface);
    font-size: 0.875rem;
    margin-block-end: 1.5rem;
  }
  .cform__preview strong {
    display: block;
    margin-block-end: 0.4rem;
  }
  .cform__group {
    margin: 0;
    padding: 0;
    border: 0;
    min-inline-size: 0;
  }
  .cform__group .cform__grid {
    clear: both;
  }
  .cform__group + .cform__group {
    margin-block-start: clamp(1.75rem, 4vw, 2.5rem);
    padding-block-start: clamp(1.5rem, 3vw, 2rem);
    border-block-start: 1px solid var(--line);
  }
  /* float hebt die Legende aus dem Fieldset-Rahmen, sonst läuft die Linie durch sie. */
  .cform__legend {
    float: left;
    inline-size: 100%;
    padding: 0;
    margin-block-end: 1.1rem;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--text);
  }

  .cform__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .cform__grid {
    display: grid;
    gap: var(--space-lg);
  }
  .field {
    display: grid;
    align-content: start;
    gap: 0.4rem;
  }
  .field label {
    font-weight: var(--fw-medium);
    font-size: var(--fs-small);
  }
  .field__req {
    color: var(--ks-cyan);
    font-weight: var(--fw-regular);
    font-size: 0.8rem;
  }
  .field__opt {
    color: var(--text-muted);
    font-weight: var(--fw-regular);
    font-size: 0.8rem;
  }
  /* Ohne min-inline-size behalten Felder ihre Standardbreite (~20 Zeichen)
     und sprengen sehr schmale Viewports. */
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-inline-size: 0;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 0;
    background: var(--ks-cream);
    font-size: var(--fs-body);
    transition: border-color var(--dur-fast) var(--ease-out);
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 1px;
    border-color: var(--accent-mark);
  }
  .field textarea {
    resize: vertical;
    min-height: 8rem;
  }
  .field input,
  .field select,
  .field textarea {
    /* Fester Kopfbereich: Beim Springen zu einem Feld bleibt die Beschriftung sichtbar. */
    scroll-margin-block: calc(var(--header-h) + 4rem) 6rem;
  }
  .field [aria-invalid='true'] {
    border-color: #ff8a7a;
  }
  .field__hint {
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  /* Fehlertexte entstehen erst im Browser und tragen deshalb kein Astro-Scope-Attribut. */
  .field :global(.field__error) {
    font-size: 0.85rem;
    line-height: 1.4;
    color: #ff8a7a;
  }
  .cform__privacy {
    margin-block-start: var(--space-lg);
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: 60ch;
  }

  .cform__actions {
    margin-block-start: var(--space-lg);
  }
  .cform__feedback {
    display: grid;
    gap: 0.75rem;
    margin-block-start: var(--space-md);
  }
  .cform__status {
    font-size: var(--fs-small);
  }
  .cform__status:empty {
    display: none;
  }
  .cform__missing {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cform__missing[hidden],
  .cform__fallback[hidden] {
    display: none;
  }
  .cform__missing :global(button) {
    min-height: 40px;
    padding: 0.4rem 0.85rem;
    border: 1px solid #ff8a7a;
    background: transparent;
    color: var(--text);
    font-size: 0.9rem;
    cursor: pointer;
  }
  .cform__missing :global(button:hover),
  .cform__missing :global(button:focus-visible) {
    background: color-mix(in srgb, #ff8a7a 15%, transparent);
  }
  .cform__fallback {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  .cform__fallback-note {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .cform__status[data-state='ok'] {
    color: #6ee39a;
  }
  .cform__status[data-state='error'] {
    color: #ff8a7a;
  }

  @media (min-width: 40rem) {
    .cform__grid {
      grid-template-columns: 1fr 1fr;
    }
    .field--full {
      grid-column: 1 / -1;
    }
  }
</style>

<script>
  // Progressive Enhancement: Ohne JS funktioniert das Formular als normaler POST an PHP.
  // Mit JS: Client-Validierung, Absenden per fetch, Statusmeldung in Live-Region.
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');

  /**
   * Kontext aus der Adresszeile vorbelegen – ausschließlich über Whitelist.
   *
   * Interne Links übergeben den Kontext als Fragment (`#leistung=` / `#branche=`),
   * damit Crawler keine URLs mit dynamischen Parametern sehen. Ältere Links mit
   * `?leistung=` / `?branche=` funktionieren weiter.
   * Der Wert wird nur zum Vergleich benutzt.
   * Gesetzt wird immer der Wert aus der serverseitig erzeugten Liste, nie der
   * Wert aus der URL. Kein Schreiben in innerHTML, keine Ausgabe im Text.
   */
  if (form) {
    const params = new URLSearchParams(window.location.search);
    new URLSearchParams(window.location.hash.slice(1)).forEach((wert, schluessel) => {
      params.set(schluessel, wert);
    });

    const wunschLeistung = params.get('leistung');
    const erlaubteKeys = (form.dataset.serviceKeys ?? '').split(',').filter(Boolean);
    if (wunschLeistung && erlaubteKeys.includes(wunschLeistung)) {
      const select = form.querySelector<HTMLSelectElement>('#cf-service');
      const treffer = select?.querySelector<HTMLOptionElement>(
        `option[data-key="${CSS.escape(wunschLeistung)}"]`,
      );
      if (select && treffer) select.value = treffer.value;
    }

    const wunschBranche = params.get('branche');
    const erlaubteSlugs = (form.dataset.branchSlugs ?? '').split(',').filter(Boolean);
    if (wunschBranche && erlaubteSlugs.includes(wunschBranche)) {
      const feld = form.querySelector<HTMLInputElement>('[data-branch-field]');
      let labels: Record<string, string> = {};
      try {
        labels = JSON.parse(form.dataset.branchLabels ?? '{}');
      } catch {
        /* ohne Beschriftungen bleibt der Slug – beides stammt aus der Whitelist */
      }
      // Index aus der Whitelist, nicht der Rohwert aus der Adresszeile.
      const slug = erlaubteSlugs[erlaubteSlugs.indexOf(wunschBranche)];
      if (feld) feld.value = labels[slug] ?? slug;
    }
  }

  /** Nachrichtentext aus allen ausgefüllten Feldern, für das E-Mail-Programm. */
  const mailtoHref = (f: HTMLFormElement): string => {
    const data = new FormData(f);
    const fields = [
      ['Name', 'name'],
      ['E-Mail', 'email'],
      ['Telefon', 'phone'],
      ['Unternehmen', 'company'],
      ['Leistung', 'service'],
      ['Budget', 'budget'],
      ['Projektumfang', 'scope'],
      ['Start', 'timing'],
      ['Website', 'existing_site'],
      ['Branche', 'branch'],
      ['Nachricht', 'message'],
    ];
    const body = fields
      .filter(([, key]) => String(data.get(key) ?? '').trim())
      .map(([label, key]) => `${label}: ${String(data.get(key)).trim()}`)
      .join('\n\n');
    return `mailto:${f.dataset.email}?subject=${encodeURIComponent('Website-Anfrage an KERNSEITE')}&body=${encodeURIComponent(body)}`;
  };

  if (form && form.dataset.preview !== undefined) {
    const status = form.querySelector<HTMLElement>('[data-status]');
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;
      window.location.href = mailtoHref(form);
      if (status)
        status.textContent =
          'Bitte sende die vorbereitete Nachricht in deinem E-Mail-Programm ab. Falls es sich nicht öffnet, nutze die E-Mail-Adresse neben dem Formular.';
    });
  } else if (form) {
    form.noValidate = true;
    const status = form.querySelector<HTMLElement>('[data-status]');
    const missing = form.querySelector<HTMLUListElement>('[data-missing]');
    const fallback = form.querySelector<HTMLElement>('[data-fallback]');
    const fallbackMail = form.querySelector<HTMLAnchorElement>('[data-fallback-mail]');
    const submit = form.querySelector<HTMLButtonElement>('[data-submit]');
    const renderedAt = form.querySelector<HTMLInputElement>('[data-rendered-at]');
    if (renderedAt) renderedAt.value = String(Date.now());

    type Field = HTMLInputElement | HTMLTextAreaElement;
    const name = form.elements.namedItem('name') as HTMLInputElement;
    const email = form.elements.namedItem('email') as HTMLInputElement;
    const message = form.elements.namedItem('message') as HTMLTextAreaElement;
    const required: Field[] = [name, email, message];
    /** Nach dem ersten Absendeversuch wird bei jeder Eingabe neu geprüft. */
    let attempted = false;

    const setStatus = (state: '' | 'ok' | 'error', text: string): void => {
      if (!status) return;
      status.dataset.state = state;
      status.textContent = text;
    };

    const setError = (field: Field, message: string | null): void => {
      const wrap = field.closest('.field');
      let err = wrap?.querySelector<HTMLElement>('.field__error');
      if (message) {
        field.setAttribute('aria-invalid', 'true');
        if (!err && wrap) {
          err = document.createElement('p');
          err.className = 'field__error';
          err.id = field.id + '-error';
          const hint = field.getAttribute('aria-describedby');
          field.dataset.originalDescribedby = hint ?? '';
          field.setAttribute('aria-describedby', [hint, err.id].filter(Boolean).join(' '));
          wrap.appendChild(err);
        }
        if (err) err.textContent = message;
      } else {
        field.removeAttribute('aria-invalid');
        if (err) {
          const hint = field.dataset.originalDescribedby;
          if (hint) field.setAttribute('aria-describedby', hint);
          else field.removeAttribute('aria-describedby');
          err.remove();
        }
      }
    };

    /** Fehlertext für ein Pflichtfeld, oder null wenn es passt. */
    const problem = (field: Field): string | null => {
      const value = field.value.trim();
      if (field === name) return value ? null : 'Bitte gib deinen Namen an.';
      if (field === email) {
        if (!value) return 'Bitte gib deine E-Mail-Adresse an.';
        return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)
          ? null
          : 'Bitte prüfe die E-Mail-Adresse, z. B. name@firma.de.';
      }
      if (!value) return 'Bitte beschreibe kurz, worum es geht.';
      return value.length >= 10 ? null : 'Ein paar Worte mehr, bitte (mindestens 10 Zeichen).';
    };

    /** Liste der fehlenden Felder unter dem Button; jeder Eintrag springt zum Feld. */
    const showMissing = (fields: Field[]): void => {
      if (!missing) return;
      // Nur neu aufbauen, wenn sich etwas ändert: Sonst verschwindet beim Klick der
      // Knopf, weil das Verlassen des vorigen Felds die Liste aktualisiert.
      const key = fields.map((f) => f.name).join(',');
      if (missing.dataset.key === key) return;
      missing.dataset.key = key;
      missing.replaceChildren(
        ...fields.map((field) => {
          const li = document.createElement('li');
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = field.dataset.label ?? field.name;
          btn.addEventListener('click', () => focusField(field));
          li.append(btn);
          return li;
        }),
      );
      missing.hidden = fields.length === 0;
    };

    const focusField = (field: Field): void => {
      field.scrollIntoView({ block: 'center', behavior: 'smooth' });
      field.focus({ preventScroll: true });
    };

    const validate = (): Field[] => {
      const invalid: Field[] = [];
      for (const field of required) {
        const msg = problem(field);
        setError(field, msg);
        if (msg) invalid.push(field);
      }
      return invalid;
    };

    const refreshAfterAttempt = (): void => {
      const invalid = validate();
      showMissing(invalid);
      if (invalid.length === 0 && status?.dataset.state === 'error' && fallback?.hidden) {
        setStatus('', '');
      }
    };

    for (const field of required) {
      // Erst nach Verlassen eines ausgefüllten Felds hinweisen, nicht schon beim Tippen.
      field.addEventListener('blur', () => {
        if (attempted) return refreshAfterAttempt();
        if (field.value.trim()) setError(field, problem(field));
      });
      field.addEventListener('input', () => {
        if (attempted) return refreshAfterAttempt();
        if (field.getAttribute('aria-invalid') === 'true' && !problem(field)) setError(field, null);
      });
    }

    const showFallback = (show: boolean): void => {
      if (!fallback) return;
      fallback.hidden = !show;
      if (show && fallbackMail) fallbackMail.href = mailtoHref(form);
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      attempted = true;
      showFallback(false);
      const invalid = validate();
      showMissing(invalid);
      if (invalid.length) {
        const labels = invalid.map((f) => f.dataset.label).join(', ');
        setStatus('error', `Bitte prüfe die markierten Felder: ${labels}.`);
        focusField(invalid[0]!);
        return;
      }

      if (submit) submit.disabled = true;
      setStatus('', 'Anfrage wird gesendet …');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
          signal: AbortSignal.timeout(20000),
        });
        const data = response.headers.get('content-type')?.includes('application/json')
          ? await response.json().catch(() => null)
          : null;
        if (response.ok && data?.ok === true) {
          setStatus(
            'ok',
            'Danke! Deine Anfrage ist eingegangen. Wir melden uns so bald wie möglich.',
          );
          form.reset();
          attempted = false;
          showMissing([]);
          if (renderedAt) renderedAt.value = String(Date.now());
          status?.scrollIntoView({ block: 'center', behavior: 'smooth' });
          return;
        }
        // Der Server nennt die betroffenen Felder: dort markieren statt allgemein melden.
        if (response.status === 422 && data?.errors && typeof data.errors === 'object') {
          const invalidServer: Field[] = [];
          for (const field of required) {
            const msg = (data.errors as Record<string, unknown>)[field.name];
            if (typeof msg === 'string') {
              setError(field, msg);
              invalidServer.push(field);
            }
          }
          if (invalidServer.length) {
            showMissing(invalidServer);
            setStatus('error', 'Bitte prüfe die markierten Felder.');
            focusField(invalidServer[0]!);
            return;
          }
        }
        if (response.status === 429 && typeof data?.message === 'string') {
          setStatus('error', data.message);
          return;
        }
        throw new Error('Versand fehlgeschlagen');
      } catch {
        setStatus(
          'error',
          'Das Senden hat gerade nicht geklappt. Deine Angaben sind noch da: Schick sie mit einem Klick per E-Mail oder ruf kurz an.',
        );
        showFallback(true);
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>

<style>
  .cform {
    background: var(--ks-cream);
    padding: clamp(1.25rem, 3vw, 3rem);
    border-radius: 0;
  }
  .cform__email-note {
    font-size: 0.9375rem;
    margin-bottom: 1.5rem;
    color: var(--text-muted);
  }
  .field input,
  .field select,
  .field textarea {
    background: var(--ks-paper);
    border-radius: 0;
    min-height: 52px;
    border-color: #89867d;
  }
  .field label {
    font-size: 1rem;
  }
  .cform__actions .btn {
    max-width: 100%;
    white-space: normal;
  }
</style>
