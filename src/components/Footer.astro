---
/**
 * Footer – Spalten wie bei den Kundenseiten (Marke, Leistungen, Branchen,
 * KERNSEITE, Kontakt), darunter der große Schriftzug „KERNSEITE.“ über die
 * ganze Breite und eine schmale Leiste mit Rechtlichem.
 */
import Logo from './Logo.astro';
import { footerNav } from '../config/navigation';
import { site, canShowHostingClaim } from '../config/site';
import { activeCompany } from '../lib/config-validation';
const year = new Date().getFullYear();
const c = activeCompany;
const legal = footerNav.find((group) => group.title === 'Rechtliches');
const groups = footerNav.filter((group) => group !== legal);
const tel = `tel:+49${c.phone.replace(/\D/g, '').replace(/^0/, '')}`;
const letters = 'KERNSEITE'.split('');
---

<footer class="ft">
  <div class="content">
    <div class="ft__cols">
      <div class="ft__brand">
        <a class="ft__logo" href="/" aria-label="KERNSEITE, zur Startseite"><Logo /></a>
        <p>
          Webdesign-Agentur aus Unterfranken. Websites, die Kunden bringen, für Betriebe in ganz
          Deutschland.
        </p>
      </div>
      <nav class="ft__nav" aria-label="Footer-Navigation">
        {
          groups.map((group) => (
            <div class="ft__group">
              <h2 class="ft__label">{group.title}</h2>
              <ul role="list">
                {group.items.map((item) => (
                  <li>
                    <a href={item.href}>{item.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
      <div class="ft__group ft__contact">
        <h2 class="ft__label">Kontakt</h2>
        <ul role="list">
          <li class="ft__mail">
            <a href={`mailto:${c.email}`}>{c.email}</a>
            <button type="button" class="ft__copy-btn" data-copy={c.email}>Kopieren</button>
          </li>
          <li><a href={tel}>{c.phone}</a></li>
          <li class="ft__region">{site.region.claim}</li>
          <li class="ft__clock">
            Ortszeit <time data-clock>--:--</time> Uhr
          </li>
        </ul>
        <a class="btn btn--primary ft__cta" href="/kontakt/" data-magnetic
          >Website anfragen <span aria-hidden="true">↗</span></a
        >
      </div>
    </div>
  </div>

  <a class="ft__word" href="/" aria-label="KERNSEITE, zur Startseite" data-reveal="fade">
    <span class="ft__word-inner" aria-hidden="true">
      {letters.map((l) => <span class="ft__letter">{l}</span>)}<span
        class="ft__letter ft__letter--core"></span>
    </span>
  </a>

  <div class="content">
    <div class="ft__bottom">
      <p class="ft__copy">{`© ${year} ${c.legalDisplayName} · ${c.city}, ${site.region.state}`}</p>
      <ul class="ft__meta" role="list">
        {
          legal?.items.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
        {
          site.consentRequired && (
            <li>
              <a href="/cookie-einstellungen/">Cookie-Einstellungen</a>
            </li>
          )
        }
      </ul>
      {canShowHostingClaim && <p class="ft__copy">{site.hostingClaimText}</p>}
    </div>
  </div>
</footer>

<style>
  .ft {
    position: relative;
    overflow: clip;
    padding-block: clamp(4rem, 8vw, 7rem) 2rem;
    border-block-start: 1px solid var(--line);
    background: var(--ks-black);
    color: var(--text);
  }
  .ft__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.75rem 1.5rem;
  }
  .ft__brand {
    grid-column: 1 / -1;
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .ft__logo {
    justify-self: start;
    font-size: 1.5rem;
    text-decoration: none;
    color: var(--text);
  }
  .ft__brand p {
    max-width: 34ch;
    color: var(--text-muted);
    font-size: 1rem;
  }
  .ft__nav {
    display: contents;
  }
  .ft__label {
    margin-block-end: 1.1rem;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--text);
  }
  .ft__group ul {
    display: grid;
    gap: 0.15rem;
    margin: 0;
    padding: 0;
  }
  .ft__group a:not(.btn) {
    display: inline-block;
    padding-block: 0.4rem;
    color: var(--text-muted);
    font-size: 0.975rem;
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out),
      transform 400ms var(--ease-out);
  }
  .ft__group a:not(.btn):hover {
    color: var(--ks-cyan);
    transform: translateX(4px);
  }
  .ft__contact {
    grid-column: 1 / -1;
  }
  .ft__contact a:not(.btn) {
    color: var(--text);
  }
  .ft__region {
    padding-block: 0.4rem;
    color: var(--text-muted);
    font-size: 0.975rem;
  }
  .ft__cta {
    margin-block-start: 1.25rem;
  }

  /* --- Großer Schriftzug ------------------------------------------------- */
  .ft__word {
    display: block;
    margin-block: clamp(3rem, 7vw, 6rem) clamp(1rem, 2vw, 2rem);
    padding-inline: var(--gutter);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
  }
  .ft__word-inner {
    display: flex;
    justify-content: center;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 17.4vw, 22rem);
    font-weight: 800;
    line-height: 0.82;
    letter-spacing: -0.06em;
    padding-block-end: 0.16em;
  }
  .ft__letter {
    display: inline-block;
    transition:
      transform 600ms var(--ease-out),
      color 400ms var(--ease-out);
  }
  /* Der Kern als Quadrat statt Punkt, wie im Logo. */
  .ft__letter--core {
    inline-size: 0.2em;
    block-size: 0.2em;
    margin-inline-start: 0.06em;
    align-self: flex-end;
    margin-block-end: 0.02em;
    background: var(--ks-cyan);
  }
  .ft__letter:hover {
    transform: translateY(-0.08em);
    color: var(--ks-cyan);
  }
  /* Buchstaben steigen nacheinander auf, wenn der Footer erscheint. */
  :global(html.has-motion) .ft__word .ft__letter {
    transform: translateY(100%);
  }
  :global(html.has-motion) .ft__word.is-in .ft__letter {
    transform: none;
    transition:
      transform 1100ms var(--ease-out),
      color 400ms var(--ease-out);
  }
  :global(html.has-motion) .ft__word.is-in .ft__letter:hover {
    transform: translateY(-0.08em);
  }
  .ft__letter:nth-child(2) {
    transition-delay: 40ms;
  }
  .ft__letter:nth-child(3) {
    transition-delay: 80ms;
  }
  .ft__letter:nth-child(4) {
    transition-delay: 120ms;
  }
  .ft__letter:nth-child(5) {
    transition-delay: 160ms;
  }
  .ft__letter:nth-child(6) {
    transition-delay: 200ms;
  }
  .ft__letter:nth-child(7) {
    transition-delay: 240ms;
  }
  .ft__letter:nth-child(8) {
    transition-delay: 280ms;
  }
  .ft__letter:nth-child(9) {
    transition-delay: 320ms;
  }
  .ft__letter:nth-child(10) {
    transition-delay: 360ms;
  }

  .ft__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
  }
  .ft__copy-btn {
    min-height: 32px;
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--text-muted);
    font-size: 0.8rem;
    cursor: pointer;
    transition:
      border-color 300ms var(--ease-out),
      color 300ms var(--ease-out);
  }
  .ft__copy-btn:hover,
  .ft__copy-btn:focus-visible {
    border-color: var(--ks-cyan);
    color: var(--ks-cyan);
  }
  .ft__clock {
    padding-block: 0.4rem;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .ft__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block-start: 1.5rem;
    border-block-start: 1px solid var(--line);
  }
  .ft__copy {
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .ft__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
  }
  .ft__meta a {
    display: inline-block;
    min-height: 40px;
    padding-block: 0.6rem;
    font-size: 0.9rem;
    color: var(--text-muted);
    text-decoration: none;
  }
  .ft__meta a:hover {
    color: var(--ks-cyan);
  }

  @media (min-width: 48rem) {
    .ft__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .ft__contact {
      grid-column: auto;
    }
  }
  @media (min-width: 72rem) {
    .ft__cols {
      grid-template-columns: 1.4fr repeat(4, minmax(0, 1fr));
      gap: 2rem;
    }
    .ft__brand {
      grid-column: auto;
    }
  }
</style>
