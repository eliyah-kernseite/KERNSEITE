---
/**
 * HomeServices – alle Leistungen als große Liste. Beim Überfahren füllt sich
 * die Zeile und ein passendes Bild folgt dem Mauszeiger (`[data-preview]`).
 * Preise und Pflege folgen in HomePricing.
 */

const services = [
  {
    href: '/leistungen/websites/',
    name: 'Websites',
    line: 'Design, Texte, Technik',
    img: '/assets/references/southframe-desktop-640.webp',
  },
  {
    href: '/leistungen/seo-geo/',
    name: 'SEO & KI-Suche',
    line: 'Google, ChatGPT und Co.',
    img: '/assets/leistungen/seo-geo-640.webp',
  },
  {
    href: '/leistungen/google-unternehmensprofil/',
    name: 'Google-Profil',
    line: 'Maps und lokale Suche',
    img: '/assets/references/google-business-profile-kinderkoerbchen.webp',
  },
  {
    href: '/leistungen/branding/',
    name: 'Branding',
    line: 'Logo, Farben, Schrift',
    img: '/assets/agentur/entwurf-skizze-640.webp',
  },
  {
    href: '/leistungen/unternehmensvideo/',
    name: 'Foto & Video',
    line: 'Eigene Bilder statt Stock',
    img: '/assets/leistungen/unternehmensvideo-640.webp',
  },
  {
    href: '/leistungen/social-media/',
    name: 'Social Media',
    line: 'Beiträge mit Plan',
    img: '/assets/leistungen/social-media-640.webp',
  },
  {
    href: '/leistungen/performance-marketing/',
    name: 'Anzeigen',
    line: 'Google und Meta Ads',
    img: '/assets/agentur/laptop-notizbuch-640.webp',
  },
  {
    href: '/leistungen/ki-automatisierung/',
    name: 'KI & Automatisierung',
    line: 'Weniger Routine',
    img: '/assets/agentur/arbeitsplatz-abend-640.webp',
  },
] as const;
---

<section class="services section" aria-labelledby="services-title">
  <div class="content">
    <div class="services__head">
      <h2 id="services-title" class="services__title" data-split>Was wir machen.</h2>
      <p class="services__sub" data-reveal>
        Acht Leistungen, ein Ansprechpartner. Du musst nicht zwischen Webdesigner, Texter und
        Fotograf vermitteln.
      </p>
    </div>

    <ul class="services__list" role="list" data-preview>
      {
        services.map((s) => (
          <li data-img={s.img}>
            <a class="services__row" href={s.href}>
              <span class="services__name">{s.name}</span>
              <span class="services__line">{s.line}</span>
              <span class="services__go" aria-hidden="true">
                ↗
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .services__head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem 3rem;
    margin-block-end: clamp(2rem, 5vw, 4rem);
  }
  .services__title {
    font-size: clamp(3rem, 8vw, 8rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }
  .services__sub {
    max-width: 34ch;
    color: var(--text-muted);
    font-size: var(--fs-lead);
    line-height: 1.5;
  }
  .services__list {
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--line-strong);
  }
  .services__row {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.25rem 1.5rem;
    padding-block: clamp(1.1rem, 2.2vw, 2rem);
    padding-inline: 0.5rem;
    border-block-end: 1px solid var(--line-strong);
    color: var(--text);
    text-decoration: none;
    overflow: hidden;
    transition:
      color 450ms var(--ease-out),
      padding 450ms var(--ease-out);
  }
  /* Fläche schiebt sich von unten in die Zeile. */
  .services__row::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ks-cream);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 450ms var(--ease-out);
  }
  .services__row:hover,
  .services__row:focus-visible {
    padding-inline: 1.5rem;
  }
  .services__row:hover::before,
  .services__row:focus-visible::before {
    transform: scaleY(1);
  }
  .services__name {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 4.6vw, 4.6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .services__line {
    grid-column: 1;
    color: inherit;
    opacity: 0.7;
    font-size: 1.05rem;
  }
  .services__go {
    grid-row: 1 / span 2;
    grid-column: 2;
    font-size: clamp(1.5rem, 3vw, 2.6rem);
    transition:
      color 450ms var(--ease-out),
      transform 450ms var(--ease-out);
  }
  .services__row:hover .services__go,
  .services__row:focus-visible .services__go {
    color: var(--ks-cyan);
    transform: rotate(45deg);
  }
  @media (min-width: 56rem) {
    .services__row {
      grid-template-columns: minmax(0, 1fr) auto auto;
    }
    .services__line {
      grid-column: 2;
      grid-row: 1;
      text-align: end;
    }
    .services__go {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
