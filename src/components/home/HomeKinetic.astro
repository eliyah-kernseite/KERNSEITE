---
/**
 * HomeKinetic – was eine Website leisten soll, in drei riesigen Zeilen, die
 * beim Scrollen gegeneinander wandern (siehe `[data-drift]`).
 */
const lines = [
  { lead: 'Gefunden', drift: -18 },
  { lead: 'Verstanden', drift: 14 },
  { lead: 'Angefragt', drift: -12 },
] as const;
---

<section class="kinetic section" aria-labelledby="kinetic-title">
  <h2 id="kinetic-title" class="visually-hidden">
    Was deine Website leisten soll: gefunden, verstanden und angefragt werden
  </h2>
  <div class="kinetic__lines" aria-hidden="true">
    {
      lines.map((l, i) => (
        <p class={`kinetic__line kinetic__line--${i + 1}`} data-drift={l.drift}>
          <span class="kinetic__lead">{l.lead}</span> werden.
        </p>
      ))
    }
  </div>
  <div class="content">
    <div class="kinetic__foot" data-reveal>
      <p class="kinetic__text">
        Genau dafür bauen wir jede Seite. <span>Damit aus Besuchern Anfragen werden.</span>
      </p>
      <a class="link-arrow kinetic__link" href="#arbeiten"
        >Arbeiten ansehen <span class="arrow" aria-hidden="true">→</span></a
      >
    </div>
  </div>
</section>

<style>
  .kinetic {
    overflow: clip;
  }
  .kinetic__lines {
    display: grid;
    gap: clamp(0.25rem, 1vw, 1rem);
  }
  .kinetic__line {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 8.8vw, 10rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.065em;
    white-space: nowrap;
    color: color-mix(in srgb, var(--ks-bone) 42%, transparent);
  }
  .kinetic__line--1 {
    padding-inline-start: 4vw;
  }
  .kinetic__line--2 {
    text-align: end;
    padding-inline-end: 2vw;
  }
  .kinetic__line--3 {
    padding-inline-start: 14vw;
  }
  .kinetic__lead {
    color: var(--text);
  }
  .kinetic__line--2 .kinetic__lead {
    color: var(--ks-cyan);
  }
  /* Fußzeile des Abschnitts: fest im Raster, Linie oben, Text links, Link rechts. */
  .kinetic__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem 3rem;
    margin-block-start: clamp(3rem, 6vw, 5.5rem);
    padding-block-start: clamp(1.5rem, 2.5vw, 2rem);
    border-block-start: 1px solid var(--line-strong);
  }
  .kinetic__text {
    max-width: 34ch;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.4vw, 2.3rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }
  .kinetic__text span {
    color: var(--text-muted);
  }
  .kinetic__link {
    font-size: 1.1rem;
  }
  :global([data-a11y-contrast='high']) .kinetic__line {
    color: var(--text);
  }
</style>
