---
/**
 * HomeAbout – wer hinter KERNSEITE steht. Kommt direkt nach dem Hero.
 * Das Bild öffnet sich von unten, der Satz daneben färbt sich beim Scrollen
 * Wort für Wort ein. Die ausführliche Geschichte steht auf /agentur/.
 */
import Photo from '../Photo.astro';
---

<section class="about section" id="ueber-uns" aria-labelledby="about-title">
  <div class="content about__grid">
    <div class="about__media" data-reveal="clip">
      <div class="about__img" data-parallax="0.1">
        <Photo
          photo="handwerk-werkzeug"
          ratio="3x4"
          sizes="(min-width: 64rem) 38vw, 100vw"
          alt="Werkzeug an einer dunklen Werkstattwand, als Bild für die Herkunft aus dem Handwerk"
        />
      </div>
    </div>

    <div class="about__copy">
      <h2 id="about-title" class="about__title" data-split>
        Erst Handwerk.<br /><em>Dann Webdesign.</em>
      </h2>
      <p class="about__statement" data-scrub>
        Ich bin Eliyah. Ich war selbst Handwerker und weiß, wie es ist, wenn die Aufträge fehlen.
        Heute baue ich Websites, die das ändern.
      </p>
      <a class="link-arrow about__link" href="/agentur/" data-reveal
        >Mehr über mich <span class="arrow" aria-hidden="true">→</span></a
      >
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 7rem);
    align-items: center;
  }
  .about__media {
    overflow: hidden;
  }
  .about__img :global(img) {
    display: block;
    inline-size: 100%;
  }
  .about__copy {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.75rem);
  }
  .about__title {
    font-size: clamp(2.8rem, 6.5vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.042em;
  }
  .about__title em {
    font-style: normal;
    color: var(--ks-cyan);
  }
  .about__statement {
    max-width: 24ch;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.8vw, 2.7rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.035em;
  }
  .about__link {
    font-size: 1.1rem;
  }
  @media (min-width: 64rem) {
    .about__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr);
    }
  }
</style>
