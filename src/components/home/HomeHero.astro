---
/**
 * HomeHero – erster Bildschirm der Startseite.
 *
 * Hinter der Überschrift läuft eine schräg gestellte Wand aus echten
 * Kundenseiten (Laptop- und Handy-Screenshots). Die Spalten wandern
 * gegeneinander, bei reduzierter Bewegung stehen sie still. Die Wand ist rein
 * dekorativ (`aria-hidden`), die Projekte selbst folgen weiter unten.
 */
import { featuredProjects } from '../../config/cases';
import { websiteOffer } from '../../config/pricing';

const desktop = featuredProjects.map((p) => p.screenshotDesktop);
const mobile = featuredProjects.map((p) => p.screenshotMobile);

// Fünf Spalten im Wechsel aus Laptop- und Handy-Ansichten, jeweils anders sortiert.
const rotate = <T,>(list: readonly T[], by: number): T[] =>
  list.map((_, i) => list[(i + by) % list.length]);
const columns = [
  { kind: 'desktop', items: rotate(desktop, 0) },
  { kind: 'mobile', items: rotate(mobile, 1) },
  { kind: 'desktop', items: rotate(desktop, 2) },
  { kind: 'mobile', items: rotate(mobile, 3) },
  { kind: 'desktop', items: rotate(desktop, 1) },
] as const;
const from = websiteOffer.range.split('–')[0];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__wall" aria-hidden="true">
    <div class="hero__plane">
      {
        columns.map((col, c) => (
          <div class={`hero__col hero__col--${col.kind} hero__col--${c + 1}`}>
            <div class="hero__track">
              {[...col.items, ...col.items].map((shot, i) => (
                <img
                  class="hero__shot"
                  src={shot.src.replace(
                    /-(1440|390)\.webp$/,
                    col.kind === 'desktop' ? '-640.webp' : '-390.webp',
                  )}
                  width={col.kind === 'desktop' ? 640 : 390}
                  height={col.kind === 'desktop' ? 400 : 844}
                  alt=""
                  loading={i < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                  fetchpriority="low"
                />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="content hero__content">
    <h1 id="hero-title" class="hero__title">
      <span class="hero__eyebrow"
        ><span class="hero__pulse" aria-hidden="true"></span>Webdesign-Agentur aus Würzburg</span
      >
      <span class="hero__claim" data-split>Dein Können.<br />Deine <em>Website.</em></span>
    </h1>
    <div class="hero__bottom">
      <p class="hero__lead" data-reveal>
        Du machst gute Arbeit. Wir bauen dir die Website, auf der man das sieht und die dir neue
        Kunden bringt.
      </p>
      <div class="hero__actions" data-reveal>
        <a class="btn btn--primary btn--lg" href="/kontakt/" data-magnetic
          >Website anfragen <span aria-hidden="true">↗</span></a
        >
        <a class="btn btn--ghost btn--lg" href="#arbeiten">Arbeiten ansehen</a>
      </div>
      <p class="hero__price" data-reveal>
        Individuelle Websites ab <strong>{from} €</strong> netto
      </p>
    </div>
  </div>
  <a class="hero__scroll" href="#ueber-uns" aria-label="Weiter zu: Wer hinter KERNSEITE steht">
    <span aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: max(40rem, 100svh);
    display: flex;
    align-items: flex-end;
    padding-block: calc(var(--header-h) + 3rem) clamp(5.5rem, 9vh, 6.5rem);
    background: var(--ks-black);
  }

  /* --- Wand aus Kundenseiten ------------------------------------------- */
  .hero__wall {
    position: absolute;
    inset: 0;
    z-index: -2;
    perspective: 1800px;
    overflow: hidden;
  }
  .hero__plane {
    position: absolute;
    inset: -30% -20% -30% 8%;
    display: grid;
    grid-template-columns: 1.6fr 0.75fr 1.6fr 0.75fr 1.6fr;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    transform: rotateX(34deg) rotateZ(-16deg) translateZ(-60px);
    transform-origin: 60% 40%;
  }
  .hero__col {
    overflow: hidden;
  }
  .hero__track {
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    animation: hero-drift 70s linear infinite;
  }
  .hero__col--2 .hero__track,
  .hero__col--4 .hero__track {
    animation-direction: reverse;
    animation-duration: 55s;
  }
  .hero__col--3 .hero__track {
    animation-duration: 85s;
  }
  .hero__shot {
    inline-size: 100%;
    block-size: auto;
    border-radius: clamp(8px, 1vw, 14px);
    border: 1px solid color-mix(in srgb, var(--ks-bone) 10%, transparent);
    background: var(--ks-surface);
  }
  .hero__col--mobile .hero__shot {
    border-radius: clamp(14px, 1.8vw, 26px);
  }
  @keyframes hero-drift {
    to {
      transform: translate3d(0, calc(-50% - 0.5 * clamp(0.75rem, 1.5vw, 1.5rem)), 0);
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, var(--ks-black), transparent 22%),
      linear-gradient(
        to top,
        var(--ks-black) 8%,
        color-mix(in srgb, var(--ks-black) 55%, transparent) 55%,
        color-mix(in srgb, var(--ks-black) 30%, transparent)
      ),
      linear-gradient(
        to right,
        var(--ks-black) 10%,
        color-mix(in srgb, var(--ks-black) 40%, transparent) 70%
      );
  }

  /* --- Text -------------------------------------------------------------- */
  .hero__content {
    position: relative;
    inline-size: 100%;
  }
  .hero__title {
    display: grid;
    gap: clamp(1rem, 2.5vw, 2rem);
    max-width: none;
    letter-spacing: normal;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.3;
    color: var(--text-muted);
  }
  .hero__pulse {
    position: relative;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    background: var(--ks-cyan);
  }
  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--ks-cyan);
    animation: hero-pulse 2.4s var(--ease-out) infinite;
  }
  @keyframes hero-pulse {
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }
  .hero__claim {
    display: block;
    font-size: clamp(3.4rem, 11.5vw, 11.5rem);
    font-weight: 800;
    line-height: 0.98;
    letter-spacing: -0.055em;
    color: var(--text);
  }
  .hero__claim em {
    font-style: normal;
    color: var(--ks-cyan);
  }

  .hero__bottom {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    margin-block-start: clamp(2rem, 4vw, 3.25rem);
  }
  .hero__lead {
    max-width: 34ch;
    font-size: clamp(1.1rem, 1.5vw, 1.35rem);
    line-height: 1.5;
    color: var(--text);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .hero__price {
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .hero__price strong {
    color: var(--text);
  }

  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    bottom: clamp(3rem, 7vh, 5.5rem);
    display: none;
    inline-size: 52px;
    block-size: 84px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
  }
  .hero__scroll span {
    position: absolute;
    left: 50%;
    top: 16px;
    inline-size: 4px;
    block-size: 14px;
    margin-left: -2px;
    border-radius: 4px;
    background: var(--ks-cyan);
    animation: hero-scroll 2s var(--ease-in-out) infinite;
  }
  @keyframes hero-scroll {
    60% {
      transform: translateY(36px);
      opacity: 0;
    }
    100% {
      opacity: 0;
    }
  }

  @media (min-width: 56rem) {
    .hero__bottom {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: 3rem;
    }
    .hero__lead {
      grid-column: 1;
    }
    .hero__actions {
      grid-column: 1;
    }
    .hero__price {
      grid-column: 1;
    }
    .hero__scroll {
      display: block;
    }
  }

  @media (max-width: 40rem) {
    .hero__plane {
      inset: -20% -60% -20% -10%;
    }
    .hero__shade {
      background:
        linear-gradient(to bottom, var(--ks-black), transparent 18%),
        linear-gradient(
          to top,
          var(--ks-black) 30%,
          color-mix(in srgb, var(--ks-black) 60%, transparent) 70%,
          color-mix(in srgb, var(--ks-black) 35%, transparent)
        );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__track,
    .hero__pulse::after,
    .hero__scroll span {
      animation: none;
    }
  }
  :global(:root[data-a11y-motion='reduced']) .hero__track {
    animation: none;
  }
</style>
