---
/**
 * HomeHero – erster Bildschirm der Startseite.
 *
 * Hinter der Überschrift läuft eine schräg gestellte Wand aus echten
 * Kundenseiten (Laptop- und Handy-Screenshots). Die Spalten wandern
 * gegeneinander, bei reduzierter Bewegung stehen sie still. Die Wand ist rein
 * dekorativ (`aria-hidden`), die Projekte selbst folgen weiter unten.
 */
import { featuredProjects } from '../../config/cases';
import Seal from '../Seal.astro';

const desktop = featuredProjects.map((p) => p.screenshotDesktop);
const mobile = featuredProjects.map((p) => p.screenshotMobile);

// Fünf Spalten im Wechsel aus Laptop- und Handy-Ansichten, jeweils anders sortiert.
const rotate = <T,>(list: readonly T[], by: number): T[] =>
  list.map((_, i) => list[(i + by) % list.length]);
const columns = [
  { kind: 'desktop', items: rotate(desktop, 0) },
  { kind: 'mobile', items: rotate(mobile, 1) },
  { kind: 'desktop', items: rotate(desktop, 2) },
  { kind: 'mobile', items: rotate(mobile, 3) },
  { kind: 'desktop', items: rotate(desktop, 1) },
] as const;
---

<section class="hero" aria-labelledby="hero-title" data-pin>
  <div class="hero__stage">
    <div class="hero__wall" aria-hidden="true">
      <div class="hero__plane" data-depth="36">
        {
          columns.map((col, c) => (
            <div class={`hero__col hero__col--${col.kind} hero__col--${c + 1}`}>
              <div class="hero__track">
                {[...col.items, ...col.items].map((shot, i) => (
                  <img
                    class="hero__shot"
                    src={shot.src.replace(
                      /-(1440|390)\.webp$/,
                      col.kind === 'desktop' ? '-640.webp' : '-390.webp',
                    )}
                    width={col.kind === 'desktop' ? 640 : 390}
                    height={col.kind === 'desktop' ? 400 : 844}
                    alt={shot.alt}
                    loading={i < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                    fetchpriority="low"
                  />
                ))}
              </div>
            </div>
          ))
        }
      </div>
    </div>
    <div class="hero__shade" aria-hidden="true"></div>

    <div class="content hero__content">
      <h1 id="hero-title" class="hero__title" data-split>
        Dein Können.<br />Deine <em>Website.</em>
      </h1>
      <div class="hero__bottom">
        <p class="hero__lead" data-reveal>
          Webdesign aus Würzburg für Betriebe, die mehr Anfragen wollen.
        </p>
        <div class="hero__actions" data-reveal>
          <a class="btn btn--primary btn--lg" href="/kontakt/" data-magnetic
            >Website anfragen <span aria-hidden="true">↗</span></a
          >
          <a class="btn btn--ghost btn--lg" href="#arbeiten">Arbeiten ansehen</a>
        </div>
      </div>
      <Seal class="hero__seal" />
    </div>
  </div>
</section>

<style>
  /* Der Hero ist höher als der Bildschirm: Seine Bühne klebt oben, während
     die Wand beim Scrollen heranzoomt und die Schrift nach oben weicht. */
  .hero {
    position: relative;
    background: var(--ks-black);
  }
  :global(html.has-scroll-fx) .hero {
    height: 155svh;
  }
  .hero__stage {
    position: sticky;
    top: 0;
    isolation: isolate;
    overflow: clip;
    min-height: max(40rem, 100svh);
    display: flex;
    align-items: flex-end;
    padding-block: calc(var(--header-h) + 3rem) clamp(4rem, 9vh, 6.5rem);
  }
  /* Beim Scrollen zoomt die Wand heran und wird heller: Die Kundenseiten
     treten nach vorn, während die Überschrift nach oben weicht. */
  :global(html.has-scroll-fx) .hero__wall {
    transform: scale(calc(1 + var(--p, 0) * 0.35));
    will-change: transform;
  }
  :global(html.has-scroll-fx) .hero__shade {
    opacity: calc(1 - var(--p, 0) * 0.75);
  }
  :global(html.has-scroll-fx) .hero__content {
    transform: translate3d(0, calc(var(--p, 0) * -18vh), 0);
    opacity: calc(1 - var(--p, 0) * 1.6);
  }

  /* --- Wand aus Kundenseiten ------------------------------------------- */
  .hero__wall {
    position: absolute;
    inset: 0;
    z-index: -2;
    perspective: 1800px;
    overflow: hidden;
  }
  .hero__plane {
    position: absolute;
    inset: -30% -20% -30% 8%;
    display: grid;
    grid-template-columns: 1.6fr 0.75fr 1.6fr 0.75fr 1.6fr;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    transform: translate3d(var(--dx, 0px), var(--dy, 0px), 0) rotateX(34deg) rotateZ(-16deg)
      translateZ(-60px);
    transform-origin: 60% 40%;
    transition: transform 1200ms var(--ease-out);
  }
  :global(html.has-motion) .hero__wall {
    animation: hero-wall-in 2200ms var(--ease-out) both;
  }
  :global(html.has-intro) .hero__wall {
    animation-delay: 900ms;
  }
  @keyframes hero-wall-in {
    from {
      opacity: 0;
      scale: 1.18;
    }
  }
  /* Mit CSS-Scroll-Animationen (auch Handy und iPad): dieselbe Bewegung wie
     oben über --p, nur rechnet sie der Browser direkt beim Scrollen. */
  :global(html.has-sda) .hero {
    view-timeline: --hero block;
  }
  :global(html.has-sda) .hero__wall {
    animation:
      hero-wall-in 2200ms var(--ease-out) both,
      hero-zoom linear both;
    animation-timeline: auto, --hero;
    animation-range:
      normal,
      contain 0% contain 100%;
  }
  :global(html.has-sda.has-intro) .hero__wall {
    animation-delay: 900ms, 0s;
  }
  :global(html.has-sda) .hero__shade {
    animation: hero-shade linear both;
    animation-timeline: --hero;
    animation-range: contain 0% contain 100%;
  }
  :global(html.has-sda) .hero__content {
    animation: hero-leave linear both;
    animation-timeline: --hero;
    animation-range: contain 0% contain 100%;
  }
  @keyframes hero-zoom {
    from {
      transform: none;
    }
    to {
      transform: scale(1.35);
    }
  }
  @keyframes hero-shade {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.25;
    }
  }
  @keyframes hero-leave {
    0% {
      opacity: 1;
      transform: none;
    }
    62% {
      opacity: 0;
      transform: translate3d(0, -11.2vh, 0);
    }
    100% {
      opacity: 0;
      transform: translate3d(0, -18vh, 0);
    }
  }
  .hero__col {
    overflow: hidden;
  }
  .hero__track {
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1.5rem);
    animation: hero-drift 70s linear infinite;
  }
  .hero__col--2 .hero__track,
  .hero__col--4 .hero__track {
    animation-direction: reverse;
    animation-duration: 55s;
  }
  .hero__col--3 .hero__track {
    animation-duration: 85s;
  }
  .hero__shot {
    inline-size: 100%;
    block-size: auto;
    border-radius: 0;
    border: 1px solid color-mix(in srgb, var(--ks-bone) 10%, transparent);
    background: var(--ks-surface);
  }
  .hero__col--mobile .hero__shot {
    border-radius: clamp(14px, 1.8vw, 26px);
  }
  @keyframes hero-drift {
    to {
      transform: translate3d(0, calc(-50% - 0.5 * clamp(0.75rem, 1.5vw, 1.5rem)), 0);
    }
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, var(--ks-black), transparent 22%),
      linear-gradient(
        to top,
        var(--ks-black) 8%,
        color-mix(in srgb, var(--ks-black) 55%, transparent) 55%,
        color-mix(in srgb, var(--ks-black) 30%, transparent)
      ),
      linear-gradient(
        to right,
        var(--ks-black) 10%,
        color-mix(in srgb, var(--ks-black) 40%, transparent) 70%
      );
  }

  /* --- Text -------------------------------------------------------------- */
  .hero__content {
    position: relative;
    inline-size: 100%;
  }
  .hero__title {
    max-width: none;
    font-size: clamp(3.6rem, 13vw, 14rem);
    font-weight: 800;
    line-height: 0.9;
    letter-spacing: -0.045em;
    color: var(--text);
  }
  .hero__title em {
    font-style: normal;
    color: var(--ks-cyan);
  }
  .hero__content :global(.hero__seal) {
    position: absolute;
    inset-block-start: 0;
    inset-inline-end: var(--gutter);
    --seal-size: clamp(7.5rem, 10vw, 10rem);
  }
  @media (max-width: 63.99rem) {
    .hero__content :global(.hero__seal) {
      display: none;
    }
  }
  .hero__bottom {
    display: grid;
    gap: 1.5rem;
    margin-block-start: clamp(2rem, 4vw, 3.5rem);
  }
  .hero__lead {
    max-width: 30ch;
    font-size: clamp(1.2rem, 1.7vw, 1.6rem);
    line-height: 1.4;
    color: var(--text);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (min-width: 56rem) {
    .hero__bottom {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: 3rem;
    }
  }

  @media (max-width: 40rem) {
    .hero__plane {
      inset: -20% -60% -20% -10%;
    }
    .hero__shade {
      background:
        linear-gradient(to bottom, var(--ks-black), transparent 18%),
        linear-gradient(
          to top,
          var(--ks-black) 30%,
          color-mix(in srgb, var(--ks-black) 60%, transparent) 70%,
          color-mix(in srgb, var(--ks-black) 35%, transparent)
        );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__track {
      animation: none;
    }
  }
  :global(:root[data-a11y-motion='reduced']) .hero__track {
    animation: none;
  }
</style>
