---
/**
 * AccessibilityDock – „Aa“-Schalter unten links mit dem Feld „Lesbarkeit“.
 *
 * Gleiche Bedienung wie auf den Kundenseiten (z. B. Kaya Döner):
 *   Schrift     A− / A+ in drei Stufen (100 / 112,5 / 125 Prozent)
 *   Mehr Kontrast         An / Aus
 *   Bewegung reduzieren   An / Aus (hält alle Animationen an)
 *   Zurücksetzen
 *
 * Die Einstellungen liegen in `localStorage` unter `kernseite-accessibility`
 * und enthalten keine personenbezogenen Daten, deshalb ist dafür keine
 * Einwilligung nötig. Angewendet werden sie vor dem ersten Paint durch
 * `public/a11y-init.js`, damit nichts aufflackert.
 */
---

<div class="a11y" data-a11y>
  <div class="a11y__panel" id="a11y-panel" data-a11y-panel hidden>
    <p class="a11y__title" id="a11y-title">Lesbarkeit</p>
    <div class="a11y__row" role="group" aria-labelledby="a11y-size-label">
      <span id="a11y-size-label">Schrift <span data-a11y-size-value>100 %</span></span>
      <span class="a11y__pair">
        <button type="button" class="a11y__btn" data-a11y-size="down" aria-label="Schrift kleiner"
          >A−</button
        >
        <button type="button" class="a11y__btn" data-a11y-size="up" aria-label="Schrift größer"
          >A+</button
        >
      </span>
    </div>
    <div class="a11y__row">
      <span id="a11y-contrast-label">Mehr Kontrast</span>
      <button
        type="button"
        class="a11y__btn a11y__btn--switch"
        data-a11y-contrast-toggle
        aria-pressed="false"
        aria-labelledby="a11y-contrast-label">Aus</button
      >
    </div>
    <div class="a11y__row">
      <span id="a11y-motion-label">Bewegung reduzieren</span>
      <button
        type="button"
        class="a11y__btn a11y__btn--switch"
        data-a11y-motion
        aria-pressed="false"
        aria-labelledby="a11y-motion-label">Aus</button
      >
    </div>
    <button type="button" class="a11y__reset" data-a11y-reset>Zurücksetzen</button>
  </div>

  <button
    type="button"
    class="a11y__toggle"
    data-a11y-toggle
    aria-expanded="false"
    aria-controls="a11y-panel"
    aria-label="Lesbarkeit anpassen: Schriftgröße, Kontrast und Bewegung"
  >
    <span aria-hidden="true">Aa</span>
  </button>

  <p class="a11y__status" role="status" aria-live="polite" data-a11y-status></p>
</div>

<script>
  type Settings = { size: number; contrast: boolean; motion: boolean };

  const KEY = 'kernseite-accessibility';
  const SIZES = [1, 1.125, 1.25];
  const DEFAULTS: Settings = { size: 1, contrast: false, motion: false };

  function read(): Settings {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return { ...DEFAULTS };
      const p = JSON.parse(raw) as Partial<Settings>;
      return {
        size: SIZES.includes(Number(p.size)) ? Number(p.size) : 1,
        contrast: p.contrast === true,
        motion: p.motion === true,
      };
    } catch {
      return { ...DEFAULTS };
    }
  }

  function write(s: Settings) {
    try {
      localStorage.setItem(KEY, JSON.stringify(s));
    } catch {
      // Privater Modus oder gesperrter Speicher: Einstellung gilt nur für
      // diese Sitzung, die Bedienung bleibt funktionsfähig.
    }
  }

  /** Setzt die Werte am Wurzelelement, die CSS-Regeln hängen daran. */
  function apply(s: Settings) {
    const root = document.documentElement;
    root.style.setProperty('--a11y-scale', String(s.size));
    if (s.contrast) root.dataset.a11yContrast = 'high';
    else delete root.dataset.a11yContrast;
    if (s.motion) root.dataset.a11yMotion = 'reduced';
    else delete root.dataset.a11yMotion;
  }

  const percent = (size: number) => `${String(size * 100).replace('.', ',')} %`;

  const dock = document.querySelector<HTMLElement>('[data-a11y]');
  if (dock) {
    const toggle = dock.querySelector<HTMLButtonElement>('[data-a11y-toggle]')!;
    const panel = dock.querySelector<HTMLElement>('[data-a11y-panel]')!;
    const contrastBtn = dock.querySelector<HTMLButtonElement>('[data-a11y-contrast-toggle]')!;
    const motionBtn = dock.querySelector<HTMLButtonElement>('[data-a11y-motion]')!;
    const resetBtn = dock.querySelector<HTMLButtonElement>('[data-a11y-reset]')!;
    const down = dock.querySelector<HTMLButtonElement>('[data-a11y-size="down"]')!;
    const up = dock.querySelector<HTMLButtonElement>('[data-a11y-size="up"]')!;
    const sizeValue = dock.querySelector<HTMLElement>('[data-a11y-size-value]')!;
    const status = dock.querySelector<HTMLElement>('[data-a11y-status]')!;

    let state = read();

    const say = (text: string) => {
      status.textContent = text;
    };

    const paint = () => {
      contrastBtn.setAttribute('aria-pressed', String(state.contrast));
      contrastBtn.textContent = state.contrast ? 'An' : 'Aus';
      motionBtn.setAttribute('aria-pressed', String(state.motion));
      motionBtn.textContent = state.motion ? 'An' : 'Aus';
      const i = SIZES.indexOf(state.size);
      sizeValue.textContent = percent(state.size);
      down.disabled = i <= 0;
      up.disabled = i >= SIZES.length - 1;
    };

    const save = () => {
      apply(state);
      write(state);
      paint();
    };

    const open = () => {
      panel.hidden = false;
      toggle.setAttribute('aria-expanded', 'true');
      panel.querySelector<HTMLElement>('button:not([disabled])')?.focus();
    };
    const close = (focusToggle = false) => {
      panel.hidden = true;
      toggle.setAttribute('aria-expanded', 'false');
      if (focusToggle) toggle.focus();
    };

    toggle.addEventListener('click', () => {
      if (panel.hidden) open();
      else close();
    });

    const step = (by: number) => {
      const i = Math.min(SIZES.length - 1, Math.max(0, SIZES.indexOf(state.size) + by));
      state.size = SIZES[i];
      save();
      say(`Schriftgröße ${percent(state.size)}.`);
    };
    down.addEventListener('click', () => step(-1));
    up.addEventListener('click', () => step(1));

    contrastBtn.addEventListener('click', () => {
      state.contrast = !state.contrast;
      save();
      say(state.contrast ? 'Mehr Kontrast eingeschaltet.' : 'Mehr Kontrast ausgeschaltet.');
    });

    motionBtn.addEventListener('click', () => {
      state.motion = !state.motion;
      save();
      say(state.motion ? 'Bewegung reduziert.' : 'Bewegung wieder erlaubt.');
    });

    resetBtn.addEventListener('click', () => {
      state = { ...DEFAULTS };
      save();
      say('Einstellungen zurückgesetzt.');
    });

    // Escape schließt, Klick außerhalb schließt.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) close(true);
    });
    document.addEventListener('pointerdown', (e) => {
      if (panel.hidden) return;
      if (!dock.contains(e.target as Node)) close();
    });

    paint();
  }
</script>

<style>
  .a11y {
    position: fixed;
    z-index: var(--z-modal);
    inset-block-end: calc(16px + env(safe-area-inset-bottom, 0px));
    inset-inline-start: calc(12px + env(safe-area-inset-left, 0px));
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    /* Feste Größen: Das Feld soll nicht mit der Schrift der Seite wachsen. */
    font-size: 16px;
  }
  @media (min-width: 48rem) {
    .a11y {
      inset-block-end: calc(20px + env(safe-area-inset-bottom, 0px));
      inset-inline-start: calc(20px + env(safe-area-inset-left, 0px));
    }
  }
  /* Solange ein Einwilligungsbanner sichtbar ist, rückt der Schalter nach oben. */
  :global(body:has(.consent:not([hidden]))) .a11y {
    inset-block-end: calc(96px + env(safe-area-inset-bottom, 0px));
  }

  .a11y__toggle {
    display: grid;
    place-items: center;
    inline-size: 52px;
    block-size: 52px;
    border-radius: 50%;
    border: 1px solid rgba(7, 8, 9, 0.18);
    background: var(--ks-bone);
    color: var(--ks-black);
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 700;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.45);
    transition: transform 400ms var(--ease-out);
  }
  .a11y__toggle:hover {
    transform: scale(1.06);
  }
  .a11y__toggle:focus-visible {
    outline: 3px solid var(--ks-cyan);
    outline-offset: 3px;
  }

  .a11y__panel {
    inline-size: min(320px, calc(100vw - 24px));
    padding: 22px 22px 18px;
    border: 1px solid rgba(7, 8, 9, 0.12);
    border-radius: 10px;
    background: var(--ks-bone);
    color: var(--ks-black);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
    animation: a11y-in 300ms var(--ease-out);
  }
  .a11y__panel[hidden] {
    display: none;
  }
  @keyframes a11y-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .a11y__title {
    margin-block-end: 14px;
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .a11y__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-block: 8px;
    font-size: 16px;
    line-height: 1.3;
  }
  .a11y__pair {
    display: flex;
    gap: 6px;
  }
  .a11y__btn {
    min-inline-size: 48px;
    min-block-size: 48px;
    padding-inline: 10px;
    border: 1px solid rgba(7, 8, 9, 0.22);
    border-radius: 4px;
    background: transparent;
    color: var(--ks-black);
    font-size: 16px;
    font-weight: 700;
  }
  .a11y__btn:hover:not(:disabled) {
    border-color: var(--ks-black);
  }
  .a11y__btn:disabled {
    color: rgba(7, 8, 9, 0.4);
    cursor: default;
  }
  .a11y__btn--switch {
    min-inline-size: 58px;
  }
  .a11y__btn--switch[aria-pressed='true'] {
    background: var(--ks-black);
    border-color: var(--ks-black);
    color: var(--ks-bone);
  }
  .a11y__btn:focus-visible,
  .a11y__reset:focus-visible {
    outline: 3px solid var(--ks-black);
    outline-offset: 2px;
  }
  .a11y__reset {
    min-block-size: 44px;
    margin-block-start: 10px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ks-black);
    font-size: 16px;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .a11y__status {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
