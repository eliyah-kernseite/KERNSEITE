---
/**
 * Startseiten-Szene: ein ruhiger Arbeitsplatz mit Laptop, iPad und Smartphone.
 * In jedem Gerät scrollt eine echte Kundenseite langsam von oben nach unten.
 *
 * Reines HTML/CSS (keine Videos, kein JavaScript). Die Bewegung nutzt
 * Container-Query-Einheiten: Das Bild läuft genau bis zu seinem unteren Ende.
 * Bei „Bewegung reduzieren“ steht die Szene still.
 */
const base = '/assets/references/scroll';
---

<div
  class="scene"
  role="img"
  aria-label="Arbeitsplatz mit Laptop, Tablet und Smartphone. Darauf laufen Websites von KERNSEITE für Kaya Döner, Bestattungen Gorhau und die Babyschlafberatung."
>
  <div class="scene__wall" aria-hidden="true"></div>
  <div class="scene__light" aria-hidden="true"></div>

  <svg class="scene__plant" viewBox="0 0 120 200" aria-hidden="true">
    <path d="M60 128 C58 96 40 74 18 66 C36 84 46 104 54 128Z" fill="#6f8a63"></path>
    <path d="M62 128 C64 90 82 62 108 52 C88 76 76 100 68 128Z" fill="#58744f"></path>
    <path d="M60 128 C54 92 56 56 70 26 C70 62 66 96 64 128Z" fill="#7d9a6f"></path>
    <path d="M58 128 C46 104 26 98 6 102 C26 108 42 118 52 130Z" fill="#4f6a47"></path>
    <path d="M30 124 h60 l-8 70 a6 6 0 0 1 -6 6 h-32 a6 6 0 0 1 -6 -6z" fill="#e7ddd0"></path>
    <path d="M30 124 h60 l-1 9 h-58z" fill="#d8ccbc"></path>
  </svg>

  <div class="scene__desk" aria-hidden="true"></div>

  <div class="device laptop">
    <div class="laptop__lid">
      <div class="screen screen--laptop">
        <img
          src={`${base}/kaya-laptop.webp`}
          width="960"
          height="3509"
          alt=""
          decoding="async"
          fetchpriority="low"
        />
      </div>
    </div>
    <div class="laptop__base" aria-hidden="true"></div>
  </div>

  <div class="device tablet">
    <div class="screen screen--tablet">
      <img
        src={`${base}/gorhau-tablet.webp`}
        width="720"
        height="2727"
        alt=""
        decoding="async"
        fetchpriority="low"
      />
    </div>
  </div>

  <div class="device phone">
    <div class="screen screen--phone">
      <img
        src={`${base}/baby-phone.webp`}
        width="151"
        height="2576"
        alt=""
        decoding="async"
        fetchpriority="low"
      />
    </div>
  </div>
</div>

<style>
  .scene {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 11;
    border-radius: 1.5rem;
    overflow: hidden;
    isolation: isolate;
    box-shadow: 0 1.5rem 3rem #10121414;
  }

  /* Raum: warme Wand, weiches Fensterlicht, Holztisch */
  .scene__wall {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 78% 8%, #fbf8f2 0%, #efe8dc 46%, #e2d8c8 100%), var(--ks-paper);
  }
  .scene__light {
    position: absolute;
    inset: -10% -20% 20% 35%;
    background: linear-gradient(115deg, transparent 30%, #ffffff55 45%, transparent 62%);
    transform: skewX(-12deg);
    pointer-events: none;
  }
  .scene__desk {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 24%;
    background:
      linear-gradient(180deg, #cdb79a 0%, #c2a986 6%, #b99f7c 100%),
      repeating-linear-gradient(92deg, #0000 0 22px, #ffffff0a 22px 24px);
    box-shadow: inset 0 2px 0 #e4d5bf;
  }
  .scene__desk::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      178deg,
      #ffffff00 0 9px,
      #ffffff10 9px 10px,
      #00000008 10px 12px
    );
  }
  .scene__plant {
    position: absolute;
    right: 2%;
    bottom: 22.5%;
    width: 13%;
    z-index: 1;
  }
  /* Geräte */
  .device {
    position: absolute;
  }
  .screen {
    position: relative;
    overflow: hidden;
    container-type: size;
    background: #fff;
  }
  .screen img {
    display: block;
    width: 100%;
    height: auto;
    animation: page-scroll var(--dur, 26s) ease-in-out var(--delay, 0s) infinite;
    will-change: transform;
  }

  .laptop {
    left: 19%;
    bottom: 15%;
    width: 66%;
    z-index: 2;
  }
  .laptop__lid {
    padding: 2.2% 2.2% 3.2%;
    background: #1c1e21;
    border-radius: 0.9rem 0.9rem 0.25rem 0.25rem;
    box-shadow:
      0 0 0 1px #3a3d42,
      0 1.4rem 2.4rem #00000030;
  }
  .screen--laptop {
    aspect-ratio: 16 / 10;
    border-radius: 0.2rem;
    --dur: 30s;
  }
  .laptop__base {
    position: relative;
    height: 0.9rem;
    margin: 0 -7%;
    background: linear-gradient(180deg, #d9dcdf 0%, #b7bbc0 60%, #8f9398 100%);
    border-radius: 0.1rem 0.1rem 0.9rem 0.9rem;
    box-shadow: 0 0.7rem 1.2rem #00000035;
  }
  .laptop__base::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 0;
    width: 16%;
    height: 40%;
    transform: translateX(-50%);
    background: #a6aaaf;
    border-radius: 0 0 0.5rem 0.5rem;
  }

  .tablet {
    left: 4%;
    bottom: 9%;
    width: 25%;
    z-index: 3;
    padding: 3.2%;
    background: #222427;
    border-radius: 1.2rem;
    box-shadow:
      0 0 0 1px #45484d,
      0 1.4rem 2rem #00000038;
    transform: rotate(-3deg);
  }
  .screen--tablet {
    aspect-ratio: 3 / 4;
    border-radius: 0.35rem;
    --dur: 24s;
    --delay: -8s;
  }

  .phone {
    right: 4%;
    bottom: 8%;
    width: 12.5%;
    z-index: 3;
    padding: 1.3% 1.1%;
    background: #1b1d20;
    border-radius: 1.1rem;
    box-shadow:
      0 0 0 1px #45484d,
      0 1.2rem 1.8rem #00000040;
    transform: rotate(4deg);
  }
  .screen--phone {
    aspect-ratio: 9 / 19.5;
    border-radius: 0.75rem;
    --dur: 20s;
    --delay: -4s;
  }
  .phone::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 2.4%;
    width: 30%;
    height: 2.2%;
    transform: translateX(-50%);
    background: #1b1d20;
    border-radius: 1rem;
    z-index: 2;
  }

  @keyframes page-scroll {
    0%,
    8% {
      transform: translateY(0);
    }
    78%,
    86% {
      transform: translateY(calc(-100% + 100cqh));
    }
    100% {
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .screen img {
      animation: none;
    }
  }

  @media (max-width: 700px) {
    .scene {
      border-radius: 1rem;
    }
    .laptop__lid {
      border-radius: 0.5rem 0.5rem 0.15rem 0.15rem;
    }
    .laptop__base {
      height: 0.5rem;
    }
    .tablet {
      border-radius: 0.7rem;
    }
    .phone {
      border-radius: 0.6rem;
    }
    .screen--phone {
      border-radius: 0.4rem;
    }
  }
</style>
