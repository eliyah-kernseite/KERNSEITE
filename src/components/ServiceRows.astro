---
import { services } from '../config/services';
import Photo from './Photo.astro';
import type { PhotoKey } from '../config/photos';
interface Props {
  exclude?: readonly string[];
  headingLevel?: 'h2' | 'h3' | 'h4';
  compact?: boolean;
}
const { exclude = [], headingLevel = 'h3' } = Astro.props;
const rows = services.filter((s) => !exclude.includes(s.key));
const Tag = headingLevel;
/** Ein Bild je Leistung. Es steht als Stimmung in der Ecke und läuft in die Kachel aus. */
const tilePhoto: Record<string, PhotoKey> = {
  websites: 'website-laptop',
  'seo-geo': 'seo-geo',
  google: 'google-karte',
  branding: 'branding-farben',
  ads: 'anzeigen-analyse',
  video: 'unternehmensvideo',
  social: 'social-media',
  ki: 'ki-roboterarm',
};
const copy: Record<string, string> = {
  websites:
    'Eine Website, die erklärt, was du machst, und unverwechselbar nach deinem Betrieb aussieht. Design, Texte und Technik kommen von uns.',
  'seo-geo':
    'Die Fragen deiner Kunden beantworten und dein Angebot für Suchmaschinen und KI-Systeme verständlich machen.',
  google:
    'Leistungen, Öffnungszeiten und Kontakt dort aktuell halten, wo Menschen nach Unternehmen in ihrer Nähe suchen.',
  branding:
    'Logo, Farben und Schriften, die zusammenpassen, damit man dich auf dem Firmenwagen genauso erkennt wie auf Instagram.',
  ads: 'Anzeigen bei Google, Instagram und Facebook, dazu eine passende Landingpage und eine Auswertung ohne Fachchinesisch.',
  video:
    'Fotos und Filme aus deinem Betrieb, vom Konzept bis zum fertigen Schnitt. Damit man sieht, wie es bei dir aussieht.',
  social:
    'Beiträge, die nach deinem Unternehmen aussehen, und ein Themenplan, der auch in vollen Wochen machbar bleibt.',
  ki: 'Wiederkehrende Aufgaben automatisieren, wo es sich lohnt. Die letzte Entscheidung trifft weiterhin ein Mensch.',
};
---

<div class="service-grid" data-reveal-group>
  {
    rows.map((s) => (
      <article class:list={['service-tile', s.isCore && 'service-tile--core']}>
        {tilePhoto[s.key] && (
          <div class="service-tile__media">
            <Photo
              photo={tilePhoto[s.key]!}
              ratio="fill"
              sizes={s.isCore ? '(min-width: 44rem) 55vw, 100vw' : '(min-width: 44rem) 30vw, 70vw'}
            />
          </div>
        )}
        <div class="service-tile__copy">
          <>
            <Tag>
              <a class="service-tile__link" href={s.href}>
                {s.key === 'google' ? 'Lokal gefunden werden.' : s.cardTitle}
              </a>
            </Tag>
            <p>{copy[s.key] ?? s.teaser}</p>
            <span class="service-tile__more">
              {s.isCore ? 'Website-Angebot entdecken' : 'Leistung kennenlernen'}{' '}
              <span aria-hidden="true">↗</span>
            </span>
          </>
        </div>
      </article>
    ))
  }
</div>
<style>
  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
  }
  .service-tile {
    position: relative;
    background: var(--ks-paper);
    border-radius: 0;
    text-decoration: none;
    color: var(--text);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.2s;
  }
  .service-tile:hover {
    transform: translateY(-4px);
  }
  /* Die ganze Kachel bleibt klickbar; Linktext ist nur die Überschrift. */
  .service-tile__link,
  .service-tile__link:hover {
    color: inherit;
    text-decoration: none;
  }
  .service-tile__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .service-tile__link:focus-visible {
    outline: none;
  }
  .service-tile:has(.service-tile__link:focus-visible) {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }
  .service-tile__copy {
    padding: clamp(1.6rem, 3vw, 3rem);
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: start;
  }
  .service-tile h2,
  .service-tile h3,
  .service-tile h4 {
    font-size: clamp(1.9rem, 3vw, 2.8rem);
    line-height: 1.1;
    max-width: 20ch;
  }
  .service-tile p {
    margin: 1.2rem 0 1.7rem;
    color: var(--text-muted);
    max-width: 45ch;
    font-size: 1.05rem;
  }
  .service-tile__more {
    font-size: 0.9375rem;
    font-weight: 600;
    display: flex;
    gap: 1rem;
    align-items: center;
    margin-top: auto;
    min-height: 44px;
  }
  .service-tile--core {
    background: var(--ks-cream);
    box-shadow: inset 0 2px 0 var(--ks-cyan);
    grid-column: span 2;
  }
  /* Das Bild sitzt oben rechts und verläuft nach links unten in die Fläche,
     der Text steht davor. So verschmilzt es mit der Kachel statt als Block
     darüber zu stehen. */
  .service-tile {
    isolation: isolate;
    min-block-size: clamp(24rem, 34vw, 30rem);
    justify-content: flex-end;
  }
  .service-tile__copy {
    flex: 0 0 auto;
  }
  .service-tile__media {
    position: absolute;
    inset: 0 0 auto auto;
    z-index: -1;
    inline-size: 72%;
    block-size: 78%;
    overflow: hidden;
    -webkit-mask-image: radial-gradient(120% 110% at 100% 0%, #000 30%, transparent 70%);
    mask-image: radial-gradient(120% 110% at 100% 0%, #000 30%, transparent 70%);
    pointer-events: none;
  }
  .service-tile__media :global(.photo) {
    block-size: 100%;
    min-block-size: 0;
    background: transparent;
  }
  .service-tile__media :global(img) {
    filter: saturate(0.6) brightness(0.62);
    transition:
      transform 1200ms var(--ease-out),
      filter 700ms var(--ease-out);
  }
  .service-tile:hover .service-tile__media :global(img) {
    transform: scale(1.06);
    filter: saturate(0.95) brightness(0.8);
  }
  .service-tile--core {
    min-block-size: clamp(22rem, 30vw, 28rem);
  }
  .service-tile--core .service-tile__media {
    inline-size: 62%;
    block-size: 100%;
    -webkit-mask-image: radial-gradient(100% 120% at 100% 50%, #000 30%, transparent 72%);
    mask-image: radial-gradient(100% 120% at 100% 50%, #000 30%, transparent 72%);
  }
  .service-tile--core .service-tile__media :global(img) {
    filter: saturate(0.55) brightness(0.55);
  }
  .service-tile--core .service-tile__copy {
    max-inline-size: 40rem;
  }
  .service-tile:nth-child(2) {
    background: var(--ks-black);
    color: var(--ks-bone);
  }
  .service-tile:nth-child(2) h2,
  .service-tile:nth-child(2) h3 {
    color: inherit;
  }
  .service-tile:nth-child(2) p {
    color: #c5c8cb;
  }
  @media (max-width: 700px) {
    .service-grid {
      grid-template-columns: 1fr;
    }
    .service-tile--core {
      grid-column: auto;
    }
  }
</style>
