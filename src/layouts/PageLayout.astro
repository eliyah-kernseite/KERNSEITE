---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import type { PhotoKey } from '../config/photos';
import type { Crumb } from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/jsonld';

interface Props {
  title?: string;
  description?: string;
  /** Reine Text-Headline. Alternativ den Slot `h1` mit Markup nutzen. */
  h1?: string;
  /** Wenn true, wird die Headline aus dem Slot `h1` gerendert. */
  h1Slot?: boolean;
  lead?: string;
  breadcrumbs?: Crumb[];
  extraJsonLd?: Array<Record<string, unknown> | null>;
  noindex?: boolean;
  /** Hintergrund des Seitenkopfs. */
  variant?: 'paper' | 'cream' | 'surface' | 'dark';
  /** Stimmungsbild im Seitenkopf: rechts hinter der Überschrift, weich in den Grund verlaufend. */
  photo?: PhotoKey;
  photoAlt?: string;
}

const {
  title,
  description,
  h1,
  h1Slot = false,
  lead,
  breadcrumbs = [],
  extraJsonLd = [],
  noindex = false,
  variant = 'paper',
  photo,
  photoAlt,
} = Astro.props;
const hasFoot = !!lead || Astro.slots.has('hero-extra');

const jsonLd = [breadcrumbJsonLd(breadcrumbs), ...extraJsonLd];
---

<BaseLayout title={title ?? h1} description={description} noindex={noindex} jsonLd={jsonLd}>
  <header
    class:list={[
      'page-hero',
      `section--${variant}`,
      { 'on-dark': variant === 'dark', 'page-hero--photo': !!photo },
    ]}
  >
    {
      photo && (
        <div class="page-hero__media">
          <div class="page-hero__img" data-parallax="0.06">
            <Photo
              photo={photo}
              ratio="fill"
              sizes="(min-width: 56rem) 70vw, 100vw"
              priority
              alt={photoAlt}
              class="page-hero__photo"
            />
          </div>
        </div>
      )
    }
    <div class:list={['content', 'page-hero__grid', { 'page-hero__grid--foot': hasFoot }]}>
      {breadcrumbs.length > 1 && <Breadcrumbs items={breadcrumbs} />}
      {
        h1Slot ? (
          <slot name="h1" />
        ) : (
          <h1 class="page-hero__title" data-split>
            {h1}
          </h1>
        )
      }
      {
        hasFoot && (
          <div class="page-hero__foot" data-reveal>
            {lead && <p class="lead page-hero__lead">{lead}</p>}
            <slot name="hero-extra" />
          </div>
        )
      }
    </div>
  </header>
  <slot />
</BaseLayout>

<style>
  /* Raster des Seitenkopfs: oben die große Überschrift, darunter eine Zeile mit
     Linie, links der Pfad, rechts Einleitung und Schaltflächen. So stehen die
     kleinen Texte an festen Plätzen statt lose auf der Fläche. */
  .page-hero__grid {
    display: grid;
    grid-template-areas:
      'title'
      'crumbs'
      'foot';
    row-gap: clamp(1.25rem, 2.5vw, 2rem);
  }
  .page-hero__grid > :global(.breadcrumbs) {
    grid-area: crumbs;
  }
  .page-hero__grid > :global(h1) {
    grid-area: title;
  }
  .page-hero__foot {
    grid-area: foot;
    display: grid;
    gap: var(--space-lg);
    justify-items: start;
  }
  .page-hero :global(h1) {
    font-size: clamp(3rem, 1.6rem + 6.4vw, 8.5rem) !important;
    line-height: 0.95 !important;
    letter-spacing: -0.045em !important;
    max-width: min(15ch, 100%) !important;
  }
  .page-hero__lead {
    font-size: var(--fs-lead);
    max-width: min(46ch, 100%) !important;
    color: var(--text-muted);
  }
  .page-hero__foot :global(.page-actions),
  .page-hero__foot :global(.detail-actions) {
    margin: 0;
  }
  @media (min-width: 56rem) {
    .page-hero__grid--foot {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      grid-template-areas:
        'title title'
        'crumbs foot';
      align-items: start;
    }
    .page-hero__grid--foot > :global(.breadcrumbs),
    .page-hero__foot {
      margin-block-start: clamp(1.5rem, 3vw, 2.5rem);
      padding-block-start: clamp(1.25rem, 2vw, 1.75rem);
      border-block-start: 1px solid var(--line-strong);
    }
  }

  /* Stimmungsbild: Das Foto steht rechts hinter der Überschrift und läuft nach
     links und unten weich in den dunklen Grund aus. Die Überschrift ragt ins
     Bild hinein, so wirkt der Kopf wie eine Komposition statt Text plus Kachel. */
  .page-hero--photo {
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-block-size: clamp(34rem, 82svh, 58rem);
  }
  .page-hero--photo > .content {
    inline-size: 100%;
  }
  .page-hero__media {
    position: absolute;
    inset: 0 0 0 auto;
    z-index: -1;
    inline-size: min(70%, 80rem);
    overflow: hidden;
    -webkit-mask-image: radial-gradient(130% 105% at 100% 0%, #000 38%, transparent 74%);
    mask-image: radial-gradient(130% 105% at 100% 0%, #000 38%, transparent 74%);
    pointer-events: none;
  }
  .page-hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      205deg,
      color-mix(in srgb, var(--ks-cyan) 16%, transparent),
      transparent 45%
    );
  }
  .page-hero__img {
    position: absolute;
    inset: 0;
  }
  .page-hero__media :global(.page-hero__photo) {
    block-size: 100%;
    min-block-size: 0;
    background: transparent;
  }
  .page-hero__media :global(img) {
    filter: saturate(0.72) brightness(0.74) contrast(1.06);
  }
  :global(html.has-motion) .page-hero__media {
    animation: hero-photo-in 1800ms var(--ease-out) both;
  }
  @keyframes hero-photo-in {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }
  @media (max-width: 55.99rem) {
    .page-hero--photo {
      min-block-size: 0;
      padding-block-start: clamp(10rem, 42vw, 16rem) !important;
    }
    .page-hero__media {
      inline-size: 100%;
      block-size: min(78%, 34rem);
      -webkit-mask-image: linear-gradient(to bottom, #000 30%, transparent 96%);
      mask-image: linear-gradient(to bottom, #000 30%, transparent 96%);
    }
    .page-hero__media :global(img) {
      filter: saturate(0.7) brightness(0.6);
    }
  }
</style>
