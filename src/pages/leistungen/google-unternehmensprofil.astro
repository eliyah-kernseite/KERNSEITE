---
/**
 * Google-Unternehmensprofil – Aufbau um den echten Screenshot.
 *
 * Eigene Komposition: kompakter Kopf, echter Profil-Screenshot mit
 * Erklärung, vier Optimierungsbereiche, die Verbindung zur Website und ein
 * echtes Referenzbeispiel. Keine erfundenen Zahlen, keine Platzierungs-
 * versprechen.
 */
import PageLayout from '../../layouts/PageLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import RelatedServices from '../../components/RelatedServices.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { getService } from '../../config/services';
import { works, type ProjectWork } from '../../config/cases';
import { serviceJsonLd, faqPageJsonLd } from '../../lib/jsonld';

const service = getService('google');
const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: 'Leistungen', path: '/leistungen/' },
  { name: service.label, path: service.href },
];
const pageFaqs = [
  {
    question: 'Was ist ein Google-Unternehmensprofil?',
    answer:
      'Das Google-Unternehmensprofil, früher Google My Business, ist der Eintrag deines Unternehmens in der Google-Suche und in Google Maps. Dort sehen Menschen Adresse, Öffnungszeiten, Telefonnummer, Fotos, Leistungen und Bewertungen. Bei Suchen mit Ortsbezug ist das Profil oft das Erste, was Interessenten von dir sehen, noch bevor sie deine Website besuchen.',
  },
  {
    question: 'Kann ein bestehendes Profil optimiert werden?',
    answer:
      'Ja. Wir prüfen Kategorien, Leistungen, Beschreibung, Fotos und Öffnungszeiten und gleichen alles mit deiner Website ab. Häufig fehlen Leistungen, Bilder sind veraltet oder Angaben widersprechen sich. Eine bestimmte Platzierung sagen wir bewusst nicht zu, denn die Reihenfolge bestimmt Google selbst.',
  },
  {
    question: 'Warum gehören Website und Profil zusammen?',
    answer:
      'Gefunden werden ist der erste Schritt, überzeugen der zweite. Wenn jemand vor Ort sucht und auf dein Profil klickt, sollte die verlinkte Seite genau die Leistung zeigen, nach der gesucht wurde. Einheitliche Namen, Adressen und Telefonnummern auf Profil und Website helfen außerdem, dein Unternehmen eindeutig zuzuordnen.',
  },
  {
    question: 'Wie gehe ich mit Bewertungen um?',
    answer:
      'Bitte zufriedene Kunden aktiv um eine ehrliche Bewertung, zum Beispiel mit einem kurzen Link nach Abschluss des Auftrags. Antworte freundlich und sachlich, auch auf kritische Bewertungen. Gekaufte oder selbst geschriebene Bewertungen sind tabu: Sie verstoßen gegen die Richtlinien und schaden dem Vertrauen.',
  },
  {
    question: 'Wie oft muss das Profil gepflegt werden?',
    answer:
      'Immer dann, wenn sich etwas ändert: Öffnungszeiten an Feiertagen, neue Leistungen, Betriebsurlaub oder ein neuer Standort. Dazu kommen ab und zu neue Fotos. Wenn es zählt, müssen die Angaben stimmen, denn falsche Öffnungszeiten kosten schnell einen Kunden.',
  },
  {
    question: 'Brauche ich ein Profil, wenn ich keine Laufkundschaft habe?',
    answer:
      'Auch Betriebe ohne Ladengeschäft profitieren, etwa Handwerker oder Dienstleister, die zu ihren Kunden fahren. Im Profil lässt sich ein Einzugsgebiet statt einer öffentlichen Adresse angeben. So erscheinst du bei Suchen in deiner Region, ohne deine Privatanschrift zu zeigen.',
  },
];

const reference = works.find(
  (w): w is ProjectWork => w.kind === 'project' && w.slug === 'kinderkoerbchen',
);

const areas = [
  {
    t: 'Profil sauber aufsetzen',
    b: 'Kategorien, Öffnungszeiten, Kontaktwege und Fotos vollständig hinterlegen.',
  },
  {
    t: 'Leistungen eindeutig darstellen',
    b: 'Was ihr anbietet, steht als Leistung im Profil und nicht nur auf der Website.',
  },
  {
    t: 'Website und Profil verbinden',
    b: 'Gleiche Angaben, gleiche Sprache, passende Landeseiten statt Startseiten-Link für alles.',
  },
  {
    t: 'Bewertungen begleiten',
    b: 'Ein Ablauf für Anfragen und Antworten. Sachlich, zeitnah und ohne gekaufte Sterne.',
  },
];
---

<PageLayout
  title="Google-Unternehmensprofil Würzburg"
  description="Google-Unternehmensprofil aus dem Raum Würzburg: vollständig eingerichtet, gepflegt und auf die Website abgestimmt. Für Anfragen aus der Umgebung."
  h1="Gefunden werden, wenn es vor Ort zählt."
  lead="Wer in der Nähe sucht, entscheidet schnell. Aktuelle Öffnungszeiten, passende Leistungen und der richtige Kontakt helfen dabei, dich zu finden und zu erreichen."
  breadcrumbs={breadcrumbs}
  extraJsonLd={[serviceJsonLd(service), faqPageJsonLd(pageFaqs)]}
>
  <!-- Echter Screenshot mit Erklärung -->
  <section class="section section--cream">
    <div class="content gsplit">
      <figure class="gsplit__shot">
        <img
          src="/assets/references/google-business-profile-kinderkoerbchen.webp"
          width="455"
          height="569"
          alt="Google-Unternehmensprofil von Anna-Lena’s Kinderkörbchen mit Adresse, Öffnungszeiten, Telefonnummer und Bewertungen."
          decoding="async"
        />
        <figcaption class="gsplit__cap">
          Echtes Unternehmensprofil eines KERNSEITE-Projekts
        </figcaption>
      </figure>
      <div class="gsplit__text">
        <h2 class="g__h2">Was Google sieht, entscheidet mit.</h2>
        <p class="gsplit__body">
          Viele Anfragen entstehen nicht auf der Website, sondern direkt in der Suche und in Maps.
          Unvollständige oder widersprüchliche Angaben führen dazu, dass Google Angebot und Standort
          nicht eindeutig zuordnet.
        </p>
        <p class="gsplit__note">
          Wir gleichen Adresse, Öffnungszeiten und Leistungen mit deiner Website ab. Die Einrichtung
          und eine laufende Pflege werden getrennt vereinbart.
        </p>
      </div>
    </div>
  </section>

  <!-- Vier Optimierungsbereiche -->
  <section class="section section--paper">
    <div class="content">
      <h2 class="g__h2 g__h2--gap">Woran wir arbeiten.</h2>
      <ul class="areas" role="list">
        {
          areas.map((a) => (
            <li class="areas__item">
              <h3 class="areas__title">{a.t}</h3>
              <p class="areas__body">{a.b}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Verbindung Website und Profil -->
  <section class="link section--dark on-dark">
    <div class="content">
      <p class="link__text">
        Aktuelle Öffnungszeiten. Richtige Kontaktdaten. Eine Website, die zur Suche passt.
      </p>
    </div>
  </section>

  <!-- Echtes Referenzbeispiel -->
  {
    reference && (
      <section class="section section--surface">
        <div class="content gref">
          <div>
            <h2 class="g__h2">Ein Beispiel aus der Praxis.</h2>
            <p class="gref__body">
              Für {reference.title} haben wir Website und Unternehmensprofil aufeinander abgestimmt:
              gleiche Leistungen, gleiche Kontaktwege, gleiche Öffnungszeiten.
            </p>
            <a class="link-arrow gref__link" href={reference.href}>
              Projekt ansehen<span class="visually-hidden">: {reference.title}</span>{' '}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
          <img
            class="gref__shot"
            src={reference.screenshotDesktop.src}
            srcset={reference.screenshotDesktop.srcset}
            sizes="(min-width: 64rem) 50vw, 100vw"
            width={reference.screenshotDesktop.width}
            height={reference.screenshotDesktop.height}
            alt={reference.screenshotDesktop.alt}
            loading="lazy"
            decoding="async"
          />
        </div>
      </section>
    )
  }

  {
    pageFaqs.length > 0 && (
      <section class="section section--cream">
        <div class="content">
          <h2 class="g__h2 g__h2--gap">Kurz gefragt.</h2>
          <FaqAccordion items={pageFaqs} />
        </div>
      </section>
    )
  }

  <RelatedServices exclude="google" only={['seo-geo', 'websites', 'social']} />
  <CtaBanner
    markedTitle={['Deine Kunden suchen in der Nähe.', 'Findet man dich bei ', 'Google', '?']}
    text="Wir schauen uns dein Profil gemeinsam an und klären, welche Angaben und Fotos für deinen Betrieb wirklich zählen."
    ctaLabel="Google-Profil besprechen"
    ctaHref="/kontakt/?leistung=google"
  />
</PageLayout>

<style>
  .g__h2 {
    font-size: var(--fs-h3);
    max-width: min(15ch, 100%);
  }
  .g__h2--gap {
    margin-block-end: clamp(1.75rem, 1.5rem + 2vw, 3rem);
  }

  .gsplit {
    display: grid;
    gap: clamp(1.75rem, 1.5rem + 2vw, 3rem);
    align-items: center;
  }
  .gsplit__shot {
    margin: 0;
    justify-self: start;
    max-inline-size: 24rem;
  }
  .gsplit__shot img {
    inline-size: 100%;
    block-size: auto;
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--radius-image);
  }
  .gsplit__cap {
    margin-block-start: var(--space-sm);
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .gsplit__body {
    margin-block-start: var(--space-lg);
    color: var(--text-muted);
    max-width: min(50ch, 100%);
  }
  .gsplit__note {
    margin-block-start: var(--space-lg);
    font-size: var(--fs-small);
    color: var(--text-muted);
    max-width: min(50ch, 100%);
  }
  @media (min-width: 64rem) {
    .gsplit {
      grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }

  .areas {
    display: grid;
    gap: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .areas__item {
    padding-block-start: var(--space-md);
    border-block-start: 2px solid var(--accent-mark);
  }
  .areas__title {
    font-size: var(--fs-h5);
  }
  .areas__body {
    margin-block-start: 0.35rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  @media (min-width: 48rem) {
    .areas {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 4vw, 4rem);
    }
  }

  .link {
    padding-block: clamp(3rem, 2rem + 4vw, 5rem);
  }
  .link__text {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: clamp(1.35rem, 2.8vw, 2.4rem);
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text-invert);
    max-width: min(32ch, 100%);
  }

  .gref {
    display: grid;
    gap: clamp(1.75rem, 1.5rem + 2vw, 3rem);
    align-items: center;
  }
  .gref__body {
    margin-block-start: var(--space-md);
    color: var(--text-muted);
    max-width: min(46ch, 100%);
  }
  .gref__link {
    margin-block-start: var(--space-lg);
  }
  .gref__shot {
    inline-size: 100%;
    block-size: auto;
    display: block;
    border-radius: var(--radius-image);
  }
  @media (min-width: 64rem) {
    .gref {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }
</style>

<style>
  .gsplit__shot {
    padding: 2rem;
    background: var(--ks-surface);
    border-radius: 1rem;
  }
  .gsplit__shot img {
    margin: auto;
  }
  .areas {
    gap: 1.5rem !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }
  .areas__item {
    border: 0 !important;
    padding: 2rem !important;
    background: var(--ks-cream);
    border-radius: 1rem;
  }
  .areas__title {
    font-size: 1.65rem;
  }
  .areas__body {
    font-size: 1rem;
  }
  .g__h2 {
    max-width: 22ch;
    font-size: var(--fs-h2);
  }
  @media (max-width: 700px) {
    .areas {
      grid-template-columns: 1fr !important;
    }
  }
</style>
