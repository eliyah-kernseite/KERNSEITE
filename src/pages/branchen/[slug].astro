---
import PageLayout from '../../layouts/PageLayout.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import FaqSection from '../../components/FaqSection.astro';
import { faqPageJsonLd } from '../../lib/jsonld';
import AccentWord from '../../components/AccentWord.astro';
import { industries, type Industry } from '../../config/industries';
import Photo from '../../components/Photo.astro';
import { photos, type PhotoKey } from '../../config/photos';
import { resolvePhoto } from '../../lib/photo';
import { getService, type ServiceKey } from '../../config/services';
import { works, type ProjectWork } from '../../config/cases';

export function getStaticPaths() {
  return industries.map((industry) => ({
    params: { slug: industry.slug },
    props: { industry },
  }));
}

interface Props {
  industry: Industry;
}
const { industry }: Props = Astro.props;

const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: 'Branchen', path: '/branchen/' },
  { name: industry.label, path: industry.href },
];
const related = industry.relatedServices.map((key) => getService(key as ServiceKey));

// Hauptmotiv der Branche – nur, wenn die Datei tatsächlich vorliegt.
const heroPhoto = (
  industry.slug in photos && resolvePhoto(industry.slug as PhotoKey) ? industry.slug : null
) as PhotoKey | null;

/** Zweites Motiv je Branche, eingebettet neben den Schwerpunkten. */
const secondBySlug: Partial<Record<string, PhotoKey>> = {
  'gastronomie-hotels': 'hotelzimmer',
};
const second = secondBySlug[industry.slug];
const sidePhoto = second && resolvePhoto(second) ? second : null;

// Branchentypische Referenz, wenn vorhanden.
const projects = works.filter((w): w is ProjectWork => w.kind === 'project');
const refBySlug: Record<string, string | undefined> = {
  'gastronomie-hotels': 'kaya-doener-himmelstadt',
  'lokale-dienstleister': 'kinderkoerbchen',
};
const reference = projects.find((p) => p.slug === refBySlug[industry.slug]);

/** Ein markiertes Wort je Branchen-Headline. */
const accentBySlug: Record<string, string> = {
  handwerk: 'Aufträge',
  zahnarztpraxen: 'Vertrauen',
  'gastronomie-hotels': 'Gäste',
  'lokale-dienstleister': 'Nähe',
  'b2b-mittelstand': 'Anfragen',
};
const accent = accentBySlug[industry.slug];
const idx = accent ? industry.detailH1.indexOf(accent) : -1;
const pre = idx >= 0 ? industry.detailH1.slice(0, idx) : industry.detailH1;
const post = idx >= 0 ? industry.detailH1.slice(idx + accent.length) : '';
---

<PageLayout
  title={industry.seoTitle}
  description={industry.metaDescription}
  h1Slot
  variant="paper"
  lead={industry.intro}
  breadcrumbs={breadcrumbs}
  extraJsonLd={[faqPageJsonLd(industry.faqs)]}
  photo={heroPhoto ?? undefined}
>
  <h1 slot="h1" data-split>
    {pre}{idx >= 0 && <AccentWord>{accent}</AccentWord>}{post}
  </h1>

  <a
    slot="hero-extra"
    class="btn btn--primary btn--lg"
    href={`/kontakt/#branche=${industry.slug}`}
    data-magnetic>{industry.ctaLabel} <span aria-hidden="true">↗</span></a
  >
  <section class="section section--cream">
    <div class:list={['content', 'focus-wrap', { 'focus-wrap--photo': !!sidePhoto }]}>
      <div class="focus-wrap__side">
        <h2 class="sec" data-split>Worauf es hier ankommt.</h2>
        {
          sidePhoto && (
            <div class="focus-wrap__photo" data-reveal="fade">
              <Photo photo={sidePhoto} ratio="3x4" sizes="(min-width: 64rem) 30vw, 90vw" />
            </div>
          )
        }
      </div>
      <ul class="focus" role="list" data-reveal-group>
        {
          industry.focus.map((f) => (
            <li class="focus__item">
              <h3 class="focus__title">{f.title}</h3>
              <p class="focus__text">{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    reference && (
      <section class="section section--surface">
        <div class="content ref">
          <div>
            <h2 class="ref__title">{reference.headline}</h2>
            <p class="ref__body">{industry.referenceText ?? reference.tagline}</p>
            <a class="link-arrow" href={reference.href}>
              Projekt ansehen<span class="visually-hidden">: {reference.title}</span>{' '}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
          <span class="ref__media" aria-hidden="true">
            <img
              src={reference.screenshotDesktop.src}
              srcset={reference.screenshotDesktop.srcset}
              sizes="(min-width: 64rem) 55vw, 100vw"
              width={reference.screenshotDesktop.width}
              height={reference.screenshotDesktop.height}
              alt={reference.screenshotDesktop.alt}
              loading="lazy"
              decoding="async"
            />
          </span>
        </div>
      </section>
    )
  }

  <section class="section section--paper">
    <div class="content">
      <h2 class="sec" data-split>Das bringt dich hier weiter.</h2>
      <ul class="rel" role="list">
        {
          related.map((r) => (
            <li>
              <div class="rel__link">
                <span class="rel__main">
                  <a class="rel__name" href={r.href}>
                    {r.cardTitle}
                  </a>
                  <span class="rel__teaser">{industry.relatedTeasers[r.key] ?? r.teaser}</span>
                </span>
                <span class="rel__go" aria-hidden="true">
                  →
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FaqSection items={industry.faqs} title={['Gut zu', 'wissen.']} variant="paper" />

  <CtaBanner
    title={industry.ctaTitle}
    text={industry.ctaText}
    ctaLabel={industry.ctaLabel}
    ctaHref={`/kontakt/#branche=${industry.slug}`}
  />
</PageLayout>

<style>
  /* Schwerpunkte: links Überschrift und ein ins Grau verlaufendes Bild, das
     beim Lesen stehen bleibt, rechts die Punkte. */
  .focus-wrap {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }
  .focus-wrap__photo {
    max-inline-size: 26rem;
    -webkit-mask-image: linear-gradient(to bottom, #000 55%, transparent);
    mask-image: linear-gradient(to bottom, #000 55%, transparent);
  }
  .focus-wrap__photo :global(img) {
    filter: saturate(0.75) brightness(0.85);
  }
  @media (min-width: 64rem) {
    .focus-wrap--photo {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(3rem, 5vw, 5rem);
      align-items: start;
    }
    .focus-wrap--photo .focus-wrap__side {
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
    .focus-wrap--photo .focus {
      grid-template-columns: minmax(0, 1fr) !important;
    }
  }

  .sec {
    font-size: var(--fs-h2);
    max-width: min(16ch, 100%);
    margin-block-end: clamp(2rem, 1.5rem + 3vw, 4rem);
  }

  .focus {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
  }
  .focus__item {
    padding-block: clamp(1.25rem, 1rem + 1.4vw, 2rem);
    border-block-end: 1px solid var(--line);
  }
  .focus__title {
    font-size: clamp(1.2rem, 2.2vw, 1.8rem);
    letter-spacing: -0.028em;
  }
  .focus__text {
    margin-block-start: 0.45rem;
    color: var(--text-muted);
    max-width: min(60ch, 100%);
    font-size: var(--fs-small);
  }

  .ref {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  .ref__title {
    margin-block-start: var(--space-md);
    font-size: var(--fs-h3);
    line-height: 1;
    max-width: min(14ch, 100%);
  }
  .ref__body {
    margin-block-start: var(--space-lg);
    color: var(--text-muted);
    max-width: min(44ch, 100%);
  }
  .ref .link-arrow {
    margin-block-start: var(--space-xl);
  }
  .ref__media img {
    inline-size: 100%;
    block-size: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    box-shadow: var(--shadow-media, 0 30px 60px rgba(0, 0, 0, 0.45));
  }

  .rel {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
  }
  .rel__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.6rem clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: clamp(1.25rem, 1rem + 1.4vw, 2rem);
    border-block-end: 1px solid var(--line);
    text-decoration: none;
    color: var(--text);
  }
  .rel__name {
    display: block;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(1.3rem, 2.6vw, 2.1rem);
    letter-spacing: var(--track-display);
    line-height: 1.05;
  }
  .rel__teaser {
    display: block;
    margin-block-start: 0.5rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: min(60ch, 100%);
  }
  .rel__go {
    color: var(--accent-mark);
    padding-block-start: 0.35em;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .rel__link:hover .rel__go {
    transform: translateX(7px);
  }
  /* Der ganze Eintrag bleibt klickbar; Linktext ist nur der Leistungsname. */
  .rel__link {
    position: relative;
  }
  .rel__name:hover {
    color: inherit;
  }
  .rel__name::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .rel__name:focus-visible {
    outline: none;
  }
  .rel__link:has(.rel__name:focus-visible) {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  @media (min-width: 64rem) {
    .ref {
      grid-template-columns: 0.85fr 1.15fr;
      gap: clamp(3rem, 5vw, 5rem);
    }
  }
</style>

<style>
  .focus {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    border: 0;
  }
  .focus__item {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--ks-paper);
    transition: border-color 400ms var(--ease-out);
  }
  .focus__item:hover {
    border-color: color-mix(in srgb, var(--ks-cyan) 45%, var(--line));
  }
  .focus__item::before {
    content: '';
    display: block;
    inline-size: 2.5rem;
    block-size: 2px;
    margin-block-end: 1.5rem;
    background: var(--ks-cyan);
  }
  .focus__title {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
  }
  .focus__text {
    font-size: 1.02rem;
  }
  .rel__link {
    border: 1px solid var(--line);
    background: var(--ks-cream);
    padding: clamp(1.25rem, 2.5vw, 1.75rem) !important;
    border-radius: 0;
    margin-bottom: 1rem;
    transition: border-color 400ms var(--ease-out);
  }
  .rel__link:hover {
    border-color: color-mix(in srgb, var(--ks-cyan) 45%, var(--line));
  }
  @media (min-width: 44rem) {
    .focus {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
