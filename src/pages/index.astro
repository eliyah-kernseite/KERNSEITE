---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Marquee from '../components/home/Marquee.astro';
import HomeAbout from '../components/home/HomeAbout.astro';
import HomeKinetic from '../components/home/HomeKinetic.astro';
import HomeWork from '../components/home/HomeWork.astro';
import HomeServices from '../components/home/HomeServices.astro';
import HomeProcess from '../components/home/HomeProcess.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import CtaBanner from '../components/CtaBanner.astro';
import { homeFaqs } from '../config/faq';
import { faqPageJsonLd } from '../lib/jsonld';

const ticker = ['Webdesign', 'SEO', 'Google-Profil', 'Branding', 'Texte', 'Foto & Video'];
---

<BaseLayout
  title="Webdesign Würzburg | Websites für Unternehmen"
  description="Webdesign-Agentur aus Würzburg: individuelle Websites mit Design, Texten und SEO, die neue Kunden bringen. Persönlich betreut, für Betriebe in ganz Deutschland."
  jsonLd={[faqPageJsonLd(homeFaqs)]}
  bodyClass="is-home"
>
  <HomeHero />
  <Marquee items={ticker} />
  <HomeAbout />
  <HomeKinetic />
  <HomeWork />
  <HomeServices />
  <HomeProcess />
  <section class="section" aria-labelledby="faq-title">
    <div class="content faq-split">
      <div>
        <h2 id="faq-title" class="display-2 faq-title" data-split>Noch Fragen?</h2>
        <a class="link-arrow" href="/faq/"
          >Alle Antworten <span class="arrow" aria-hidden="true">→</span></a
        >
      </div>
      <FaqAccordion items={homeFaqs} />
    </div>
  </section>
  <CtaBanner
    title="Lass uns reden."
    text="Erzähl kurz, was du vorhast. Das erste Gespräch ist unverbindlich."
    ctaLabel="Website anfragen"
  />
</BaseLayout>

<style>
  .faq-title {
    margin-block: 1.25rem 0.5rem;
    font-size: clamp(3rem, 7vw, 7rem);
  }
</style>
