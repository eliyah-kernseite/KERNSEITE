---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBanner from '../../components/CtaBanner.astro';
import FaqSection from '../../components/FaqSection.astro';
import GoogleProfile from '../../components/GoogleProfile.astro';
import { works, type ProjectWork } from '../../config/cases';
import { breadcrumbJsonLd, faqPageJsonLd } from '../../lib/jsonld';

export function getStaticPaths() {
  return works
    .filter((w): w is ProjectWork => w.kind === 'project')
    .map((w) => ({ params: { slug: w.slug }, props: { work: w } }));
}

interface Props {
  work: ProjectWork;
}
const { work } = Astro.props;

/** „Gastronomie / Website / digitale Speisekarte“ → einzelne Schlagworte. */
const tags = work.category
  .split('/')
  .map((part) => part.trim())
  .filter(Boolean);

const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: 'Arbeiten', path: '/arbeiten/' },
  { name: work.title, path: work.href },
];

const projects = works.filter((w): w is ProjectWork => w.kind === 'project');
const other = projects[(projects.findIndex((w) => w.slug === work.slug) + 1) % projects.length];

// Nur beim Kindertagespflege-Projekt gehört das echte Google-Profil dazu.
const showGoogleProfile = work.slug === 'kinderkoerbchen';
---

<BaseLayout
  title={work.seoTitle ??
    `${work.title}: ${work.stage === 'preview' ? 'Website-Entwurf' : 'Referenz'}`}
  description={work.tagline.slice(0, 155)}
  jsonLd={[breadcrumbJsonLd(breadcrumbs), faqPageJsonLd(work.faqs)]}
>
  <header class="chero section--paper">
    <div class="content">
      <Breadcrumbs items={breadcrumbs} />
      <h1 class="chero__title" data-split>{work.headline}</h1>
      <p class="chero__client">
        <span class="chero__kind">{work.stage === 'preview' ? 'Website-Entwurf' : 'Referenz'}</span>
        {work.title}
      </p>
      <p class="lead chero__lead">{work.tagline}</p>
      <ul class="tags chero__tags" role="list">
        {tags.map((tag) => <li class="tag">{tag}</li>)}
      </ul>
      <div class="chero__actions">
        {
          work.liveUrl ? (
            <a
              class="btn btn--primary"
              data-magnetic
              href={work.liveUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Website ansehen <span class="visually-hidden">(öffnet in neuem Tab)</span>
            </a>
          ) : (
            <a class="btn btn--primary" href="#projektvorschau">
              Entwurf ansehen
            </a>
          )
        }
        <a class="link-arrow" href="/kontakt/#leistung=websites"
          >Ähnliche Website anfragen <span class="arrow" aria-hidden="true">→</span></a
        >
        <span class="chero__domain"
          >{work.previewDomain ? `${work.previewDomain} (Beispieladresse)` : work.liveLabel}</span
        >
      </div>
    </div>
  </header>

  <section class="shot" id="projektvorschau" aria-label="Projektvorschau">
    <div class="content shot__stage" data-reveal="scale">
      <div class="shot__browser">
        <span class="shot__bar" aria-hidden="true">
          <span class="shot__url">{work.liveLabel}</span>
        </span>
        <img
          src={work.screenshotDesktop.src}
          srcset={work.screenshotDesktop.srcset}
          sizes="(min-width: 90rem) 1200px, 92vw"
          width={work.screenshotDesktop.width}
          height={work.screenshotDesktop.height}
          alt={work.screenshotDesktop.alt}
          decoding="async"
        />
      </div>
      <div class="shot__phone">
        <img
          src={work.screenshotMobile.src}
          srcset={work.screenshotMobile.srcset}
          sizes="(min-width: 64rem) 240px, 30vw"
          width={work.screenshotMobile.width}
          height={work.screenshotMobile.height}
          alt={work.screenshotMobile.alt}
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="content two">
      <div class="two__col">
        <h2 class="two__heading">Ausgangslage</h2>
        <p class="two__text">{work.situation}</p>
      </div>
      <div class="two__col">
        <h2 class="two__heading">Lösung</h2>
        <p class="two__text">{work.solution}</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="content">
      <h2 class="sec-title" data-split>Was umgesetzt wurde</h2>
      <ul class="scope" role="list">
        {
          work.scope.map((item) => (
            <li class="scope__item">
              <span class="scope__text">{item}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <FaqSection items={work.faqs} title={['Fragen', 'zum Projekt.']} variant="cream" />

  {showGoogleProfile && <GoogleProfile />}

  {
    other && (
      <section class="section nextwork-wrap">
        <div class="content">
          <a class="nextwork" href={other.href}>
            <span class="nextwork__copy">
              <span class="nextwork__label">Nächstes Projekt</span>
              <span class="nextwork__title">{other.title.split(': ').at(-1)}</span>
              <span class="nextwork__meta">{other.headline}</span>
            </span>
            <img
              class="nextwork__img"
              src={other.screenshotDesktop.src.replace('-1440.webp', '-960.webp')}
              width="960"
              height="600"
              alt={other.screenshotDesktop.alt}
              aria-hidden="true"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
      </section>
    )
  }

  <CtaBanner
    markedTitle={work.ctaTitle}
    text={`Du wünschst dir einen Auftritt, der so gut zu dir passt wie dieser zu ${work.client}? Erzähl uns von deinem Unternehmen.`}
  />
</BaseLayout>

<style>
  .chero {
    padding-block: clamp(3rem, 6vw, 6rem) clamp(2.5rem, 2rem + 3vw, 4rem);
  }
  .chero__title {
    margin-block-start: var(--space-xl);
    font-size: var(--fs-h1);
    line-height: 1.02;
    letter-spacing: -0.04em;
    max-width: min(16ch, 100%);
  }
  .chero__client {
    margin-block-start: var(--space-lg);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-lead);
  }
  /* „Referenz“ vor dem Kundennamen, getrennt durch eine kurze Cyan-Linie. */
  .chero__kind {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-inline-end: 0.6rem;
    color: var(--text-muted);
    font-weight: var(--fw-medium);
  }
  .chero__kind::after {
    content: '';
    inline-size: 1.25rem;
    block-size: 2px;
    background: var(--ks-cyan);
  }
  .chero__lead {
    margin-block-start: var(--space-md);
  }
  .chero__tags {
    margin-block-start: var(--space-lg);
  }
  .chero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-lg);
    margin-block-start: var(--space-2xl);
  }
  .chero__domain {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }

  .shot {
    padding-block: clamp(1rem, 3vw, 3rem) clamp(3rem, 6vw, 6rem);
  }
  .shot__stage {
    position: relative;
    padding-inline-end: clamp(2rem, 9vw, 9rem);
  }
  .shot__browser {
    overflow: hidden;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    background: var(--ks-surface);
    box-shadow: 0 40px 100px rgba(0, 0, 0, 0.5);
  }
  .shot__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.7rem 0.9rem;
    border-block-end: 1px solid var(--line);
  }
  .shot__url {
    margin-inline: auto;
    padding: 0.2rem 1rem;
    border-radius: 0;
    background: var(--ks-paper);
    font-size: 0.8rem;
    color: var(--text-muted);
  }
  .shot__browser img {
    inline-size: 100%;
    block-size: auto;
    display: block;
  }
  .shot__phone {
    position: absolute;
    right: 0;
    bottom: -2.5rem;
    inline-size: clamp(5.5rem, 19%, 15rem);
    overflow: hidden;
    border: 6px solid #000;
    border-radius: 28px;
    background: #000;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  }
  .shot__phone img {
    display: block;
    inline-size: 100%;
    aspect-ratio: 9 / 19.5;
    object-fit: cover;
    object-position: top;
    border-radius: 22px;
  }

  .nextwork-wrap {
    border-block-start: 1px solid var(--line);
  }
  .nextwork {
    display: grid;
    gap: 2rem;
    align-items: center;
    color: var(--text);
    text-decoration: none;
  }
  .nextwork__label {
    font-size: 1.1rem;
    color: var(--ks-cyan);
    font-weight: 600;
  }
  .nextwork__copy {
    display: grid;
    gap: 1rem;
  }
  .nextwork__title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 6vw, 6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    transition: color 400ms var(--ease-out);
  }
  .nextwork:hover .nextwork__title {
    color: var(--ks-cyan);
  }
  .nextwork__meta {
    color: var(--text-muted);
    font-size: var(--fs-lead);
  }
  .nextwork__img {
    inline-size: 100%;
    border: 1px solid var(--line-strong);
    border-radius: 0;
    transition: transform 900ms var(--ease-out);
  }
  .nextwork:hover .nextwork__img {
    transform: translateY(-8px) rotate(-1deg);
  }
  @media (min-width: 64rem) {
    .nextwork {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .two {
    display: grid;
    gap: var(--space-2xl);
  }
  .two__text {
    margin-block-start: var(--space-md);
    font-size: var(--fs-lead);
    line-height: 1.5;
    max-width: min(46ch, 100%);
  }
  .two__heading {
    font-size: clamp(1.5rem, 2vw, 2rem);
    line-height: 1.2;
  }

  .sec-title {
    font-size: var(--fs-h2);
    max-width: min(24ch, 100%);
    margin-block-end: clamp(2rem, 1.5rem + 2vw, 3.5rem);
  }
  .scope {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
  }
  .scope__item {
    padding-block: clamp(1.1rem, 0.9rem + 1.2vw, 1.9rem);
    border-block-end: 1px solid var(--line);
  }
  .scope__text {
    display: block;
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: clamp(1.2rem, 2.2vw, 1.9rem);
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  @media (min-width: 64rem) {
    .two {
      grid-template-columns: 1fr 1fr;
      gap: clamp(3rem, 5vw, 6rem);
    }
  }
</style>
