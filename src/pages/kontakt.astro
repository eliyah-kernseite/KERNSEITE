---
import PageLayout from '../layouts/PageLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { faqPageJsonLd } from '../lib/jsonld';
import Photo from '../components/Photo.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';
import { activeCompany, isPlaceholder } from '../lib/config-validation';
import { SHOW_DRAFT_NOTICES } from '../lib/build-mode';

const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: 'Kontakt', path: '/kontakt/' },
];

const c = activeCompany;
const emailReady = !isPlaceholder(c.email);
const phoneReady = !isPlaceholder(c.phone);
const phoneHref = 'tel:+49' + c.phone.replace(/\D/g, '').replace(/^0/, '');
const contactFaqs = [
  {
    question: 'Was sollte in meiner Anfrage stehen?',
    answer:
      'Erzähl uns in ein paar Sätzen, was du vorhast: Was bietet dein Unternehmen an, gibt es schon eine Website und was soll die neue leisten? Wenn du einen Wunschtermin oder ein ungefähres Budget im Kopf hast, hilft das bei der Einschätzung. Ein fertiges Briefing brauchst du nicht.',
  },
  {
    question: 'Wie geht es nach meiner Anfrage weiter?',
    answer:
      'Jede Anfrage wird persönlich gelesen und beantwortet. Meist schlagen wir dir ein kurzes Gespräch per Telefon oder Video vor, in dem wir die wichtigsten Fragen klären. Danach bekommst du ein schriftliches Angebot mit Umfang, Ablauf und Preis.',
  },
  {
    question: 'Ist das Erstgespräch verbindlich?',
    answer:
      'Nein. Das erste Gespräch ist unverbindlich. Wir lernen dein Vorhaben kennen, du lernst uns kennen, und am Ende weißt du, welcher Umfang sinnvoll ist. Erst wenn du das schriftliche Angebot annimmst, beginnt das Projekt.',
  },
  {
    question: 'Kann ich auch anrufen oder eine E-Mail schreiben?',
    answer:
      'Natürlich. Wenn du lieber sprichst als schreibst, ruf einfach an oder schick eine E-Mail. Telefonnummer und E-Mail-Adresse findest du direkt neben dem Formular. Du sprichst in jedem Fall direkt mit Eliyah.',
  },
  {
    question: 'Arbeitet KERNSEITE auch außerhalb der Region?',
    answer:
      'Ja. Der Sitz liegt in Erlabrunn bei Würzburg, Projekte begleiten wir in ganz Deutschland. Abstimmungen laufen dann per Telefon, Video und über eine gemeinsame Vorschau der Website.',
  },
  {
    question: 'Was kostet ein Website-Projekt ungefähr?',
    answer:
      'Der Orientierungsrahmen für Unternehmenswebsites liegt meist bei 1.500 bis 5.500 Euro netto. Wo dein Website-Projekt liegt, hängt von Seitenanzahl, Funktionen und Inhalten ab. Nach dem ersten Gespräch bekommst du ein schriftliches Angebot, in dem Umfang und Preis verbindlich festgehalten sind.',
  },
  {
    question: 'Muss ich Texte und Bilder schon fertig haben?',
    answer:
      'Nein. Für die Anfrage reicht eine grobe Idee. Wir helfen bei Struktur und Formulierung der Texte und planen Bildmotive mit. Fotos und Videos produzieren wir auf Wunsch selbst. Was von dir kommt und was wir übernehmen, legen wir gemeinsam zu Projektbeginn fest.',
  },
  {
    question: 'Kann ich nur eine einzelne Leistung anfragen?',
    answer:
      'Ja. Du kannst eine neue Website anfragen, aber auch einzelne Leistungen wie SEO, ein Google-Unternehmensprofil, Branding, Social Media, Werbeanzeigen, ein Unternehmensvideo oder KI-Automatisierung. Wenn mehrere Bausteine zusammen sinnvoll sind, besprechen wir das im ersten Gespräch.',
  },
];
---

<PageLayout
  extraJsonLd={[faqPageJsonLd(contactFaqs)]}
  title="Kontakt: Website-Projekt anfragen"
  description="Erzähl kurz, was du vorhast: per Formular, E-Mail oder Telefon. KERNSEITE meldet sich persönlich."
  h1="Erzähl uns, was du vorhast."
  lead="Eine neue Website, ein Relaunch oder noch eine offene Frage: Ein paar Sätze reichen. Du sprichst direkt mit Eliyah. Unverbindlich und ohne fertiges Briefing."
  breadcrumbs={breadcrumbs}
>
  <section class="section section--paper">
    <div class="content kontakt">
      <div class="kontakt__form">
        <h2 class="visually-hidden">Kontaktformular</h2>
        <ContactForm />
      </div>

      <aside class="kontakt__aside">
        <h2 class="kontakt__aside-title">Direkt erreichbar</h2>
        <ul class="channels" role="list">
          <li class="channel">
            <span class="channel__label">E-Mail</span>
            {
              emailReady ? (
                <a class="channel__value" href={`mailto:${c.email}`}>
                  {c.email}
                </a>
              ) : (
                <span class="channel__value channel__value--todo">
                  {SHOW_DRAFT_NOTICES ? 'E-Mail wird ergänzt (LEGAL_TODO)' : ''}
                </span>
              )
            }
          </li>
          <li class="channel">
            <span class="channel__label">Telefon</span>
            {
              phoneReady ? (
                <a class="channel__value" href={phoneHref}>
                  {c.phone}
                </a>
              ) : (
                <span class="channel__value channel__value--todo">
                  {SHOW_DRAFT_NOTICES ? 'Telefon wird ergänzt (LEGAL_TODO)' : ''}
                </span>
              )
            }
          </li>
          {
            site.bookingUrl && (
              <li class="channel">
                <span class="channel__label">Termin</span>
                <a
                  class="channel__value"
                  href={site.bookingUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  Termin auswählen (externer Anbieter)
                </a>
              </li>
            )
          }
        </ul>

        <div class="kontakt__note">
          <p>
            So geht es weiter: Wir sprechen über dein Ziel und den passenden Umfang. Anschließend
            erhältst du ein schriftliches Angebot. Erst nach deiner Beauftragung beginnt das
            Projekt.
          </p>
        </div>
      </aside>
    </div>
  </section>
  <!-- Standort -->
  <section class="section section--surface">
    <div class="content place">
      <div class="place__text">
        <h2 class="place__title">Aus dem Raum Würzburg. Für ganz Deutschland.</h2>
        <p class="place__body">
          Der Sitz liegt in Erlabrunn bei Würzburg. Persönliche Termine sind in der Region möglich.
          Vieles lässt sich zugleich schnell und unkompliziert digital abstimmen.
        </p>
      </div>
      <Photo photo="standort-wuerzburg" ratio="16x9" sizes="(min-width: 64rem) 55vw, 100vw" />
    </div>
  </section>
  <FaqSection items={contactFaqs} title={['Bevor du', 'schreibst.']} variant="paper" />
</PageLayout>

<style>
  .kontakt {
    display: grid;
    gap: var(--space-3xl);
    align-items: start;
  }
  .place {
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    align-items: center;
  }
  .place__title {
    font-size: var(--fs-h3);
    max-width: min(14ch, 100%);
  }
  .place__body {
    margin-block-start: var(--space-md);
    color: var(--text-muted);
    max-width: min(44ch, 100%);
  }
  @media (min-width: 64rem) {
    .place {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
      gap: clamp(2.5rem, 5vw, 5rem);
    }
  }

  .kontakt__aside-title {
    font-size: var(--fs-h3);
    margin-block-end: var(--space-lg);
  }
  .channels {
    display: grid;
    gap: var(--space-lg);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .channel {
    display: grid;
    gap: 0.2rem;
    padding-block-end: var(--space-lg);
    border-block-end: 1px solid var(--line);
  }
  .channel__label {
    font-size: var(--fs-small);
    color: var(--text-muted);
  }
  .channel__value {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--fs-h4);
    color: var(--text);
    text-decoration: none;
  }
  a.channel__value:hover {
    color: var(--accent-ink);
  }
  .channel__value--todo {
    color: var(--text-muted);
    font-size: var(--fs-small);
  }
  .kontakt__note {
    margin-block-start: var(--space-xl);
    padding: var(--space-lg);
    background: var(--ks-surface);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    font-size: var(--fs-small);
  }

  @media (min-width: 64rem) {
    .kontakt {
      grid-template-columns: 1.5fr 0.9fr;
      gap: var(--space-4xl);
    }
  }
</style>
