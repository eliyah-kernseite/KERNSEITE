---
import PageLayout from '../layouts/PageLayout.astro';
import FaqSection from '../components/FaqSection.astro';
import { faqPageJsonLd } from '../lib/jsonld';
import CtaBanner from '../components/CtaBanner.astro';
import Photo from '../components/Photo.astro';

const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: 'Über uns', path: '/agentur/' },
];

const values = [
  {
    title: 'Ein fester Ansprechpartner',
    body: 'Du besprichst dein Projekt direkt mit Eliyah. Rückfragen, Gestaltung und Umsetzung laufen an einer Stelle zusammen.',
  },
  {
    title: 'Kosten, die vorher feststehen',
    body: 'Seiten, Funktionen, Zuarbeit und Kosten werden vor Projektstart vereinbart. Erweiterungen stimmen wir mit dir ab.',
  },
  {
    title: 'Entscheidungen am Entwurf',
    body: 'Du siehst, wie deine Website aufgebaut wird, und kannst Texte und Gestaltung in Ruhe prüfen.',
  },
  {
    title: 'Zusammenarbeit auf Distanz',
    body: 'Telefon, Videogespräch und eine gemeinsame Vorschau machen die Abstimmung in ganz Deutschland möglich.',
  },
];
const agencyFaqs = [
  {
    question: 'Wer steckt hinter KERNSEITE?',
    answer:
      'KERNSEITE ist die Webdesign-Agentur von Eliyah Korb mit Sitz in Erlabrunn. Du arbeitest direkt mit der Person, die deine Website konzipiert, gestaltet und umsetzt. Wechselnde Projektmanager gibt es nicht, und so geht unterwegs auch keine Information verloren.',
  },
  {
    question: 'Wie beginnt die Zusammenarbeit?',
    answer:
      'Jedes Projekt beginnt mit einem guten Gespräch. Du erzählst, was dein Unternehmen ausmacht, wen du erreichen möchtest und was deine bisherige Website nicht leistet. Daraus entsteht eine erste Einschätzung und anschließend ein schriftliches Angebot. Das Erstgespräch ist unverbindlich.',
  },
  {
    question: 'Für welche Unternehmen arbeitet KERNSEITE?',
    answer:
      'Für Selbstständige, Handwerksbetriebe, Praxen, Gastronomie, lokale Dienstleister und mittelständische Unternehmen. Gemeinsam ist ihnen, dass sie gute Arbeit leisten und das auch online zeigen wollen. Ob du gerade gründest oder einen in die Jahre gekommenen Auftritt erneuern willst, spielt dabei keine Rolle.',
  },
  {
    question: 'Muss ich für Termine nach Erlabrunn kommen?',
    answer:
      'Nein. In der Region treffen wir uns nach Absprache gern persönlich, zum Beispiel bei dir im Betrieb. Alle anderen Projekte stimmen wir per Telefon, Videogespräch und gemeinsamer Website-Vorschau ab. So funktioniert die Zusammenarbeit in ganz Deutschland genauso gut wie vor Ort.',
  },
  {
    question: 'Was bedeutet der Name KERNSEITE?',
    answer:
      'Der Name steht für die Idee hinter jeder Website: den Kern eines Unternehmens zu finden und verständlich zu zeigen. Bevor es um Farben oder Effekte geht, klären wir, was dich ausmacht und warum Kunden zu dir kommen. Daraus entsteht eine Seite, die genau das zeigt.',
  },
  {
    question: 'Wie bleibt die Website nach dem Start aktuell?',
    answer:
      'Nach der Veröffentlichung kannst du Inhalte je nach vereinbarter Lösung selbst ändern oder Änderungen bei KERNSEITE beauftragen. Auch eine laufende Betreuung mit Updates und kleinen Anpassungen ist möglich. Was davon sinnvoll ist, besprechen wir vor dem Start.',
  },
];
---

<PageLayout
  photo="handwerk-werkzeug"
  extraJsonLd={[faqPageJsonLd(agencyFaqs)]}
  title="Eliyah Korb: Webdesign-Agentur Würzburg"
  description="Eliyah Korb kommt aus dem Handwerk und baut heute Websites, die Betrieben neue Kunden bringen. Webdesign aus Erlabrunn bei Würzburg."
  h1="Aus dem Handwerk zum Webdesign."
  lead="Ich bin Eliyah Korb. Mit KERNSEITE baue ich Websites für Unternehmen, deren gute Arbeit online gefunden werden soll. Von Erlabrunn bei Würzburg aus betreue ich Projekte in ganz Deutschland."
  breadcrumbs={breadcrumbs}
>
  <section class="section story">
    <div class="content story__grid">
      <div class="story__media" data-reveal="fade">
        <div class="story__frame">
          <div data-parallax="0.08">
            <Photo
              photo="werkbank-lampen"
              ratio="3x4"
              sizes="(min-width: 64rem) 40vw, 100vw"
              blend="bottom"
            />
          </div>
        </div>
      </div>
      <div class="story__text">
        <h2 class="story__title" data-split>Gute Arbeit allein reicht nicht.</h2>
        <p class="lead" data-reveal>
          Ich habe selbst als Handwerker gearbeitet und bei meinem damaligen Chef miterlebt, wie
          schwer es sein kann, an Aufträge zu kommen, wenn gerade wenig los ist. Wer im Internet gut
          sichtbar ist, holt in ruhigen Phasen eher noch einen Auftrag rein. Läuft es gut, kommen so
          viele Anfragen, dass es die ruhigen Phasen kaum noch gibt.
        </p>
        <p data-reveal>
          Aus dem Handwerk und dem direkten Kundenkontakt kenne ich die Frage, die viele
          Selbstständige umtreibt: Wie zeigt man, was die eigene Arbeit wert ist, bevor ein Kunde
          sie erlebt hat? Mit KERNSEITE baue ich Websites, die darauf eine Antwort geben und dein
          Unternehmen so vorstellen, wie es wirklich ist.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="content">
      <div class="section-top">
        <h2 class="display-2" data-split>Wie wir arbeiten.</h2>
      </div>
      <ul class="values" role="list" data-reveal-group>
        {
          values.map((v) => (
            <li class="values__item">
              <h3 class="values__title">{v.title}</h3>
              <p class="values__body">{v.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="content network">
      <h2 class="display-2" data-split>Ein Ansprechpartner für alles.</h2><div data-reveal>
        <p class="lead">
          Website, Branding, Social Media, Werbeanzeigen, Foto und Video sowie KI-Automatisierung:
          Bei KERNSEITE greift alles ineinander, weil alles von uns kommt.
        </p><p>
          Du musst nicht zwischen verschiedenen Dienstleistern vermitteln. Dein Ansprechpartner und
          Vertragspartner bin immer ich, Eliyah Korb von KERNSEITE.
        </p><a class="link-arrow" href="/leistungen/"
          >Leistungen kennenlernen <span class="arrow" aria-hidden="true">→</span></a
        >
      </div>
    </div>
  </section>

  <section class="section section--cream">
    <div class="content region">
      <div class="region__body">
        <h2 class="region__title" data-split>Verwurzelt im Raum Würzburg.</h2>
        <p class="region__text" data-reveal>
          Der Sitz liegt in Erlabrunn, nur wenige Minuten vor der Stadt. Als kleine Digital- und
          Werbeagentur betreuen wir Unternehmen in Würzburg, Schweinfurt, Kitzingen, Karlstadt, ganz
          Unterfranken und bundesweit. Persönliche Termine sind in der Region gern möglich. Vieles
          lässt sich aber auch schnell und unkompliziert digital abstimmen.
        </p>
        <a class="link-arrow" href="/webdesign-wuerzburg/" data-reveal
          >Webdesign in Würzburg <span class="arrow" aria-hidden="true">→</span></a
        >
      </div>
      <div class="region__photo" data-reveal="scale">
        <Photo
          photo="standort-wuerzburg"
          ratio="4x3"
          sizes="(min-width: 64rem) 50vw, 100vw"
          blend="edges"
        />
      </div>
    </div>
  </section>

  <FaqSection items={agencyFaqs} title={['Gut zu wissen,', 'bevor wir starten.']} variant="paper" />
  <CtaBanner
    title="Lernen wir uns kennen."
    text="Ein erstes Gespräch ist unverbindlich und klärt oft schon eine Menge."
    ctaLabel="Projekt besprechen"
    ctaHref="/kontakt/"
    secondaryLabel="Ablauf ansehen"
    secondaryHref="/prozess/"
  />
</PageLayout>

<style>
  .story__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .story__media {
    position: relative;
  }
  .story__frame {
    overflow: hidden;
    border-radius: 0;
  }
  .story__text {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }
  .story__text > p:not(.kicker, .lead) {
    max-width: 58ch;
    color: var(--text-muted);
  }
  .story__title {
    font-size: clamp(2.4rem, 5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    max-width: 14ch;
  }
  @media (min-width: 64rem) {
    .story__grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }
  }

  .values {
    display: grid;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .values__item {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: clamp(1.75rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: 0;
    background: var(--ks-paper);
    transition:
      border-color 500ms var(--ease-out),
      transform 600ms var(--ease-out);
  }
  .values__item:hover {
    border-color: color-mix(in srgb, var(--ks-cyan) 45%, var(--line));
    transform: translateY(-4px);
  }
  .values__title {
    font-size: clamp(1.5rem, 2.2vw, 2rem);
  }
  .values__body {
    color: var(--text-muted);
    font-size: 1rem;
  }
  @media (min-width: 48rem) {
    .values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .network {
    display: grid;
    gap: 2rem;
  }
  .network p + p {
    margin-block: 1rem 1.5rem;
    color: var(--text-muted);
  }
  @media (min-width: 56rem) {
    .network {
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: end;
    }
  }

  .region {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
  }
  .region__title {
    font-size: clamp(2.2rem, 4.4vw, 4.4rem);
    line-height: 1.02;
    max-width: 14ch;
  }
  .region__text {
    margin-block: clamp(1.25rem, 1rem + 1vw, 2rem);
    font-size: var(--fs-lead);
    line-height: 1.5;
    color: var(--text-muted);
    max-width: min(58ch, 100%);
  }
  .region__photo {
    overflow: hidden;
    border-radius: 0;
  }
  @media (min-width: 64rem) {
    .region {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(2.5rem, 5vw, 5rem);
      align-items: center;
    }
  }
</style>
