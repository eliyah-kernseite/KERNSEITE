---
import PageLayout from '../layouts/PageLayout.astro';
import CtaBanner from '../components/CtaBanner.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import Photo from '../components/Photo.astro';
import { regions, type Region } from '../config/regions';
import { resolvePhoto } from '../lib/photo';
import { getService } from '../config/services';
import { works, type ProjectWork } from '../config/cases';
import { faqPageJsonLd } from '../lib/jsonld';

/**
 * Regionale Landingpages (Würzburg, Schweinfurt). Aufbau und Gestaltung
 * entsprechen bewusst den Branchenseiten (src/pages/branchen/[slug].astro).
 */
export function getStaticPaths() {
  return regions.map((region) => ({
    params: { region: region.slug },
    props: { region },
  }));
}

interface Props {
  region: Region;
}
const { region }: Props = Astro.props;

const breadcrumbs = [
  { name: 'Start', path: '/' },
  { name: region.label, path: region.href },
];
const related = region.relatedServices.map((key) => getService(key));
const heroPhoto = region.photo && resolvePhoto(region.photo) ? region.photo : null;

// Referenz aus der Region (Himmelstadt, Landkreis Main-Spessart).
const reference =
  region.slug === 'webdesign-wuerzburg'
    ? works.find(
        (w): w is ProjectWork => w.kind === 'project' && w.slug === 'kaya-doener-himmelstadt',
      )
    : undefined;
---

<PageLayout
  title={region.seoTitle}
  description={region.metaDescription}
  h1={region.h1}
  variant="paper"
  lead={region.lead}
  breadcrumbs={breadcrumbs}
  extraJsonLd={[faqPageJsonLd(region.faqs)]}
>
  <section class="hero-img">
    {
      heroPhoto && (
        <div class="content--wide content" data-reveal="scale">
          <Photo photo={heroPhoto} ratio="21x9" sizes="100vw" priority />
        </div>
      )
    }
    <div class="content branch-action">
      <a class="btn btn--primary btn--lg" href="/kontakt/" data-magnetic
        >{region.ctaLabel} <span aria-hidden="true">↗</span></a
      >
    </div>
  </section>

  <section class="section section--cream">
    <div class="content">
      <h2 class="sec" data-split>{region.focusTitle}</h2>
      <ul class="focus" role="list" data-reveal-group>
        {
          region.focus.map((f) => (
            <li class="focus__item">
              <h3 class="focus__title">{f.title}</h3>
              <p class="focus__text">{f.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--paper">
    <div class="content">
      <h2 class="sec" data-split>{region.areaTitle}</h2>
      <p class="lead area__text">{region.areaText}</p>
    </div>
  </section>

  {
    reference && (
      <section class="section section--surface">
        <div class="content ref">
          <div>
            <h2 class="ref__title">{reference.headline}</h2>
            <p class="ref__body">{region.referenceText ?? reference.tagline}</p>
            <a class="link-arrow" href={reference.href}>
              Projekt ansehen<span class="visually-hidden">: {reference.title}</span>{' '}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          </div>
          <span class="ref__media" aria-hidden="true">
            <img
              src={reference.screenshotDesktop.src}
              srcset={reference.screenshotDesktop.srcset}
              sizes="(min-width: 64rem) 55vw, 100vw"
              width={reference.screenshotDesktop.width}
              height={reference.screenshotDesktop.height}
              alt={reference.screenshotDesktop.alt}
              loading="lazy"
              decoding="async"
            />
          </span>
        </div>
      </section>
    )
  }

  <section class="section section--paper">
    <div class="content">
      <h2 class="sec" data-split>Das bringt dich weiter.</h2>
      <ul class="rel" role="list">
        {
          related.map((r) => (
            <li>
              <div class="rel__link">
                <span class="rel__main">
                  <a class="rel__name" href={r.href}>
                    {r.cardTitle}
                  </a>
                  <span class="rel__teaser">{region.relatedTeasers[r.key] ?? r.teaser}</span>
                </span>
                <span class="rel__go" aria-hidden="true">
                  →
                </span>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--cream">
    <div class="content faq-split">
      <div>
        <h2>Häufige Fragen.</h2>
      </div><FaqAccordion items={region.faqs} />
    </div>
  </section>

  <CtaBanner
    title="Lass uns über deine Website sprechen."
    text={region.ctaText}
    ctaLabel={region.ctaLabel}
    ctaHref="/kontakt/"
  />
</PageLayout>

<style>
  .hero-img {
    padding-block-end: clamp(3.5rem, 7vw, 6rem);
    background: var(--ks-paper);
  }

  .gallery {
    display: grid;
    gap: clamp(1rem, 0.75rem + 1.5vw, 2rem);
  }
  @media (min-width: 48rem) {
    .gallery--pair {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
      align-items: start;
    }
  }

  .sec {
    font-size: var(--fs-h2);
    max-width: min(16ch, 100%);
    margin-block-end: clamp(2rem, 1.5rem + 3vw, 4rem);
  }

  .focus {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
  }
  .focus__item {
    padding-block: clamp(1.25rem, 1rem + 1.4vw, 2rem);
    border-block-end: 1px solid var(--line);
  }
  .focus__title {
    font-size: clamp(1.2rem, 2.2vw, 1.8rem);
    letter-spacing: -0.028em;
  }
  .focus__text {
    margin-block-start: 0.45rem;
    color: var(--text-muted);
    max-width: min(60ch, 100%);
    font-size: var(--fs-small);
  }

  .ref {
    display: grid;
    gap: var(--space-2xl);
    align-items: center;
  }
  .ref__title {
    margin-block-start: var(--space-md);
    font-size: var(--fs-h3);
    line-height: 1;
    max-width: min(14ch, 100%);
  }
  .ref__body {
    margin-block-start: var(--space-lg);
    color: var(--text-muted);
    max-width: min(44ch, 100%);
  }
  .ref .link-arrow {
    margin-block-start: var(--space-xl);
  }
  .ref__media img {
    inline-size: 100%;
    block-size: auto;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    object-position: top;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    box-shadow: var(--shadow-media, 0 30px 60px rgba(0, 0, 0, 0.45));
  }

  .rel {
    margin: 0;
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--line);
  }
  .rel__link {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.6rem clamp(1rem, 3vw, 2.5rem);
    align-items: start;
    padding-block: clamp(1.25rem, 1rem + 1.4vw, 2rem);
    border-block-end: 1px solid var(--line);
    text-decoration: none;
    color: var(--text);
  }
  .rel__name {
    display: block;
    color: inherit;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: var(--fw-bold);
    font-size: clamp(1.3rem, 2.6vw, 2.1rem);
    letter-spacing: var(--track-display);
    line-height: 1.05;
  }
  .rel__teaser {
    display: block;
    margin-block-start: 0.5rem;
    color: var(--text-muted);
    font-size: var(--fs-small);
    max-width: min(60ch, 100%);
  }
  .rel__go {
    color: var(--accent-mark);
    padding-block-start: 0.35em;
    transition: transform var(--dur-base) var(--ease-out);
  }
  .rel__link:hover .rel__go {
    transform: translateX(7px);
  }
  /* Der ganze Eintrag bleibt klickbar; Linktext ist nur der Leistungsname. */
  .rel__link {
    position: relative;
  }
  .rel__name:hover {
    color: inherit;
  }
  .rel__name::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .rel__name:focus-visible {
    outline: none;
  }
  .rel__link:has(.rel__name:focus-visible) {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  @media (min-width: 64rem) {
    .ref {
      grid-template-columns: 0.85fr 1.15fr;
      gap: clamp(3rem, 5vw, 5rem);
    }
  }
</style>

<style>
  .branch-action {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .focus {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    border: 0;
    counter-reset: focus;
  }
  .focus__item {
    position: relative;
    counter-increment: focus;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--ks-paper);
    transition: border-color 400ms var(--ease-out);
  }
  .focus__item:hover {
    border-color: color-mix(in srgb, var(--ks-cyan) 45%, var(--line));
  }
  .focus__item::before {
    content: counter(focus, decimal-leading-zero);
    display: block;
    margin-block-end: 1.25rem;
    font-family: var(--font-display);
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--ks-cyan);
  }
  .focus__title {
    font-size: clamp(1.4rem, 2vw, 1.8rem);
  }
  .focus__text {
    font-size: 1.02rem;
  }
  .rel__link {
    border: 1px solid var(--line);
    background: var(--ks-cream);
    padding: clamp(1.25rem, 2.5vw, 1.75rem) !important;
    border-radius: var(--radius-card);
    margin-bottom: 1rem;
    transition: border-color 400ms var(--ease-out);
  }
  .rel__link:hover {
    border-color: color-mix(in srgb, var(--ks-cyan) 45%, var(--line));
  }
  @media (min-width: 44rem) {
    .focus {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .area__text {
    max-width: min(64ch, 100%);
    color: var(--text-muted);
  }
</style>
